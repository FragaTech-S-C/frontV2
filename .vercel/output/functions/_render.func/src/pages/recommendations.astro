---
import AppLayout from '@/layouts/AppLayout.astro';
---
<AppLayout title="Sugeridos para vos">
  <p>Eventos según tus intereses.</p>
  <div id="recommendations-status" class="box" style="margin-bottom:1rem;display:none"></div>
  <div id="recommendations-grid" class="grid"></div>

  <script is:inline define:vars={{ apiBase: (import.meta.env.PUBLIC_API_URL ?? import.meta.env.BACKEND_URL ?? 'http://localhost:3000/api').replace(/\/+$/, '') }}>
    const baseApiUrl = String(apiBase || 'http://localhost:3000/api').replace(/\/+$/, '');
    if (!baseApiUrl) {
      const status = document.getElementById('recommendations-status');
      if (status) {
        status.style.display = 'block';
        status.textContent = 'La API no está configurada. Agregá PUBLIC_API_URL o BACKEND_URL en tu entorno.';
      }
      return;
    }
    const token = localStorage.getItem('meetia-access-token');
    const grid = document.getElementById('recommendations-grid');
    const status = document.getElementById('recommendations-status');

    const formatArgentinaDate = (value) => {
      if (!value) return 'Sin fecha';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return 'Sin fecha';
      const day = String(date.getDate()).padStart(2, '0');
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const year = date.getFullYear();
      return `${day}-${month}-${year}`;
    };

    const formatLocation = (event) => {
      const parts = [event.location, event.city, event.country, event.address].filter(Boolean);
      return parts.length ? parts.join(' - ') : 'Sin ubicación';
    };

    const renderRecommendations = (items) => {
      if (!grid) return;
      grid.innerHTML = '';

      if (!items || items.length === 0) {
        status.style.display = 'block';
        status.textContent = 'Todavía no tenemos recomendaciones para vos.';
        return;
      }

      const slugify = (value) => String(value || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '') || 'evento';

      items.forEach((item) => {
        const event = item.event || item;
        const card = document.createElement('a');
        const eventId = event.id ?? event._id;
        const pathTitle = slugify(event.title || event.name || 'evento') || 'evento';
        const eventPath = eventId ? `/events/${pathTitle}?id=${encodeURIComponent(String(eventId))}` : `/events/${pathTitle}`;
        card.href = eventPath;
        card.className = 'box';
        card.setAttribute('data-event-id', String(eventId ?? ''));
        card.style.textDecoration = 'none';
        card.style.color = 'inherit';
        const imageUrl = event.coverImage || event.bannerImage;
        card.innerHTML = `
          ${imageUrl ? `<img src="${imageUrl}" alt="${event.title || 'Evento'}" style="width:100%;height:180px;object-fit:cover;border-radius:12px;display:block;" />` : '<div class="ph">Evento</div>'}
          <h3>${event.title || 'Evento sin título'}</h3>
          <p>${formatArgentinaDate(event.startDate)} · ${formatLocation(event)}</p>
        `;
        card.addEventListener('click', async (clickEvent) => {
          if (!eventId) return;
          clickEvent.preventDefault();
          try {
            await fetch(`${baseApiUrl}/events/${encodeURIComponent(String(eventId))}`, {
              headers: { Authorization: `Bearer ${token}` },
            });
            window.location.href = eventPath;
          } catch (error) {
            console.error('No se pudo cargar el evento:', error);
            window.location.href = eventPath;
          }
        });
        grid.appendChild(card);
      });
    };

    const loadRecommendations = async () => {
      if (!token) {
        window.location.href = '/login';
        return;
      }

      status.style.display = 'block';
      status.textContent = 'Cargando recomendaciones...';

      try {
        const response = await fetch(`${baseApiUrl}/recommendations?limit=6`, {
          headers: { Authorization: `Bearer ${token}` },
        });

        const payload = await response.json().catch(() => []);
        if (!response.ok) {
          throw new Error(payload.message || 'No se pudieron cargar las recomendaciones.');
        }

        renderRecommendations(Array.isArray(payload) ? payload : payload.events || []);
        status.style.display = 'none';
      } catch (error) {
        status.style.display = 'block';
        status.textContent = error.message || 'No se pudieron cargar las recomendaciones.';
      }
    };

    loadRecommendations();
  </script>
</AppLayout>
