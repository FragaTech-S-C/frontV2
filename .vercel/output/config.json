{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/?$",
			"dest": "_render"
		},
		{
			"src": "^/auth/google/callback/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/?$",
			"dest": "_render"
		},
		{
			"src": "^/events/new/?$",
			"dest": "_render"
		},
		{
			"src": "^/events/([^/]+?)/edit/?$",
			"dest": "_render"
		},
		{
			"src": "^/events/([^/]+?)/route/?$",
			"dest": "_render"
		},
		{
			"src": "^/events/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/groups/new/?$",
			"dest": "_render"
		},
		{
			"src": "^/groups/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/groups/?$",
			"dest": "_render"
		},
		{
			"src": "^/invitations/?$",
			"dest": "_render"
		},
		{
			"src": "^/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/map/?$",
			"dest": "_render"
		},
		{
			"src": "^/profile/friends/?$",
			"dest": "_render"
		},
		{
			"src": "^/profile/?$",
			"dest": "_render"
		},
		{
			"src": "^/recommendations/?$",
			"dest": "_render"
		},
		{
			"src": "^/register/?$",
			"dest": "_render"
		},
		{
			"src": "^/reports/?$",
			"dest": "_render"
		},
		{
			"src": "^/reset-password/?$",
			"dest": "_render"
		},
		{
			"src": "^/reviews/?$",
			"dest": "_render"
		},
		{
			"src": "^/search/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}