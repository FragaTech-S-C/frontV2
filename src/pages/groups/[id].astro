---
import AppLayout from '@/layouts/AppLayout.astro';

export function getStaticPaths() {
  return [
    { params: { id: 'las-girls' } },
    { params: { id: 'tech-crew' } },
    { params: { id: 'design-lab' } },
    { params: { id: '1' } },
    { params: { id: '2' } },
  ];
}
---

<AppLayout title="Grupo">
  <div id="group-shell"></div>

  <script>
    type GroupMember = string | { name?: string };

    type GroupData = {
      id?: string | number;
      slug?: string;
      name?: string;
      coverImage?: string;
      avatar?: string;
      type?: string;
      leader?: string;
      description?: string;
      members?: GroupMember[];
      events?: Array<{
        id?: string;
        title?: string;
        startDate?: string;
        location?: string;
        city?: string;
        category?: string;
      }>;
    };

    type InvitationPayload = {
      id: string;
      type: 'group';
      targetId: string;
      targetName: string;
      senderName: string;
      recipientName: string;
      status: 'pending';
      createdAt: string;
      message: string;
    };

    (() => {
      const shell = document.getElementById('group-shell') as HTMLElement | null;
      if (!shell) return;

      const currentPath = window.location.pathname.split('/').filter(Boolean).pop() ?? '';
      const groups = JSON.parse(localStorage.getItem('meetia-groups') || '[]') as GroupData[];
      const slugify = (value: string = ''): string => String(value)
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '') || 'grupo';

      const group = groups.find((item: GroupData) => String(item.slug || slugify(item.name || '')) === String(currentPath))
        || groups.find((item: GroupData) => String(item.id) === String(currentPath));
      const groupId = String(group?.id ?? currentPath ?? 'group-demo');

      const mockUsers = [
        { id: 'user-1', name: 'María López' },
        { id: 'user-2', name: 'Mateo Silva' },
        { id: 'user-3', name: 'Lucía Torres' },
        { id: 'user-4', name: 'Diego Ruiz' },
      ];

      const saveInvitation = (payload: InvitationPayload) => {
        try {
          const all = JSON.parse(localStorage.getItem('meetia-invitations') || '[]') as InvitationPayload[];
          const next = Array.isArray(all) ? all : [];
          next.unshift(payload);
          localStorage.setItem('meetia-invitations', JSON.stringify(next));
        } catch (error) {
          console.warn('No se pudieron guardar invitaciones mock:', error);
        }
      };

      const setInviteStatus = (message: string, isError: boolean = false) => {
        const status = document.getElementById('group-invite-status') as HTMLDivElement | null;
        if (!status) return;
        status.style.display = 'block';
        status.textContent = message;
        status.style.borderColor = isError ? '#b91c1c' : '#2f5d8a';
        status.style.color = isError ? '#7f1d1d' : '#1f2937';
      };

      const groupInvite = async (): Promise<void> => {
        const select = document.getElementById('group-invite-user') as HTMLSelectElement | null;
        const userId = select?.value ?? '';
        if (!userId) {
          setInviteStatus('Seleccioná un usuario para invitar.', true);
          return;
        }

        const user = mockUsers.find((item) => item.id === userId);
        const payload: InvitationPayload = {
          id: `inv-${Date.now()}`,
          type: 'group',
          targetId: groupId,
          targetName: group?.name || 'Grupo',
          senderName: 'Vos',
          recipientName: user?.name || 'Usuario',
          status: 'pending',
          createdAt: new Date().toISOString(),
          message: `Te invitamos a unirte a ${group?.name || 'este grupo'}.`,
        };

        saveInvitation(payload);
        setInviteStatus(`Invitación creada para ${user?.name || 'este usuario'} (mock).`);
      };

      const joinGroup = async (): Promise<void> => {
        const token = localStorage.getItem('meetia-access-token') || localStorage.getItem('accessToken') || localStorage.getItem('access_token') || '';
        if (!groupId) return;

        if (!token) {
          setInviteStatus('Iniciá sesión para unirte o enviar invitaciones.', true);
          return;
        }

        try {
          const response = await fetch(`http://localhost:3000/api/groups/${groupId}/join`, {
            method: 'POST',
            headers: { Authorization: `Bearer ${token}` },
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) {
            throw new Error(data.message || data.error || 'No se pudo unir al grupo.');
          }
          setInviteStatus('Solicitud enviada o unión completada correctamente.');
        } catch (error: unknown) {
          const message = error instanceof Error ? error.message : 'La solicitud quedó guardada localmente.';
          setInviteStatus(message, true);
        }
      };

      const inviteElement = document.getElementById('group-invite-user') as HTMLSelectElement | null;
      if (inviteElement) {
        inviteElement.innerHTML = '<option value="">Elegir usuario</option>' + mockUsers
          .map((user) => `<option value="${user.id}">${user.name}</option>`)
          .join('');
      }

      const defaultMembers: string[] = ['Yo', 'Ana', 'Mateo'];
      const defaultEvents = [
        { id: 'event-demo-1', title: 'Meetup de comunidad', startDate: '2026-10-18T19:00:00.000Z', location: 'CABA', country: 'Argentina' },
        { id: 'event-demo-2', title: 'Workshop de diseño', startDate: '2026-10-25T18:30:00.000Z', location: 'Palermo', country: 'Argentina' },
      ];

      const members: GroupMember[] = Array.isArray(group?.members) && group.members.length ? group.members : defaultMembers;
      const events = Array.isArray(group?.events) && group.events.length ? group.events : defaultEvents;

      const cover = group?.coverImage
        ? `<img src="${group.coverImage}" alt="${group.name || 'Grupo'}" class="group-cover" />`
        : '<div class="group-cover placeholder">Portada del grupo</div>';

      const avatar = group?.avatar
        ? `<img src="${group.avatar}" alt="${group.name || 'Grupo'}" class="group-avatar" />`
        : `<div class="group-avatar letter">${(group?.name || 'G').charAt(0).toUpperCase()}</div>`;

      const memberList = members.map((member: GroupMember) => `<div class="member-pill">${typeof member === 'string' ? member : member.name || 'Miembro'}</div>`).join('');

      const eventList = events.map((event: { id?: string; title?: string; startDate?: string; location?: string; city?: string; category?: string; }) => {
        const date = event.startDate ? new Date(event.startDate) : null;
        const formattedDate = date && !Number.isNaN(date.getTime())
          ? new Intl.DateTimeFormat('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(date)
          : 'Sin fecha';

        return `
          <article class="mini-event">
            <div class="mini-event__thumb">${event.category || 'Evento'}</div>
            <div>
              <strong>${event.title || 'Evento sin título'}</strong>
              <p>${formattedDate}</p>
              <p>${event.location || event.city || 'Sin ubicación'}</p>
            </div>
          </article>
        `;
      }).join('');

      shell.innerHTML = `
        <section class="box group-header">
          ${cover}
          <div class="group-summary">
            <div class="group-title-row">
              ${avatar}
              <div>
                <h2>${group?.name || 'Grupo sin nombre'}</h2>
                <p>${group?.type === 'institutional' ? 'Grupo institucional' : 'Grupo personal'} · ${group?.leader || 'Líder'}</p>
              </div>
            </div>
            <p>${group?.description || 'Sin descripción aún.'}</p>
            <div class="row">
              <a class="btn" href="/events/new">Crear evento</a>
              <button id="join-group-btn" class="btn" type="button">Unirme al grupo</button>
            </div>

            <div class="invite-block">
              <label for="group-invite-user">Invitar miembro</label>
              <select id="group-invite-user" class="input" style="width:100%; margin-top:0.5rem;">
                <option value="">Elegir usuario</option>
              </select>
              <button id="group-invite-btn" class="btn out" type="button" style="margin-top:0.75rem; width:100%;">Enviar invitación</button>
              <div id="group-invite-status" class="ph" style="display:none; margin-top:0.75rem;"></div>
            </div>
          </div>
        </section>

        <div class="group-grid">
          <section class="box">
            <h3>Administrar grupo</h3>
            <div class="status-row">
              <span>Miembros</span>
              <strong>${members.length}</strong>
            </div>
            <div class="status-row">
              <span>Privacidad</span>
              <strong>${group?.type === 'institutional' ? 'Institucional' : 'Personal'}</strong>
            </div>
            <div class="status-row">
              <span>Estado</span>
              <strong>Activo</strong>
            </div>
          </section>

          <section class="box">
            <h3>Crear nuevo evento</h3>
            <p>Prepará una nueva actividad para este grupo.</p>
            <a class="btn" href="/events/new">Ir al formulario</a>
          </section>

          <section class="box">
            <h3>Miembros</h3>
            <div class="member-list">${memberList || '<p>No hay miembros aún.</p>'}</div>
            <button class="btn out" type="button">Gestionar miembros</button>
          </section>

          <section class="box chat-box">
            <h3>Chat del grupo</h3>
            <p>Próximamente: chat interno del grupo.</p>
            <div class="chat-placeholder">Chat en construcción</div>
          </section>

          <section class="box events-box">
            <h3>Eventos del grupo</h3>
            <div class="mini-event-list">${eventList || '<p>No hay eventos creados.</p>'}</div>
          </section>
        </div>
      `;

      document.getElementById('group-invite-btn')?.addEventListener('click', groupInvite);
      document.getElementById('join-group-btn')?.addEventListener('click', joinGroup);
    })();
  </script>

  <style>
    .group-header {
      overflow: hidden;
      padding: 0;
    }

    .group-cover {
      display: block;
      width: 100%;
      height: 220px;
      object-fit: cover;
      background: #dfe7ff;
    }

    .group-cover.placeholder {
      display: grid;
      place-items: center;
      background: linear-gradient(135deg, #eaf0ff, #eefbf6);
      color: #4b5b9d;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .group-summary {
      padding: 1.25rem 1.25rem 1.4rem;
    }

    .group-title-row {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 0.75rem;
    }

    .group-avatar {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      object-fit: cover;
      background: #e6e7ff;
      display: block;
    }

    .group-avatar.letter {
      display: grid;
      place-items: center;
      background: #dfe6ff;
      color: #2f5d8a;
      font-weight: 700;
      font-size: 1.5rem;
    }

    .group-summary h2 {
      margin: 0 0 0.25rem;
      font-size: 1.6rem;
    }

    .group-summary p {
      color: #4b5563;
    }

    .group-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1rem;
      margin-top: 1.25rem;
    }

    .status-row {
      display: flex;
      justify-content: space-between;
      padding: 0.7rem 0;
      border-bottom: 1px solid #e5e7eb;
      color: #374151;
    }

    .member-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin: 0.75rem 0 1rem;
    }

    .member-pill {
      border-radius: 999px;
      background: #eef2ff;
      color: #3749b8;
      padding: 0.45rem 0.75rem;
      font-size: 0.85rem;
      font-weight: 600;
    }

    .chat-placeholder {
      margin-top: 1rem;
      min-height: 130px;
      border: 1px dashed #bac5dd;
      border-radius: 12px;
      display: grid;
      place-items: center;
      background: #f8fafc;
      color: #64748b;
      font-weight: 600;
    }

    .invite-block {
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid #e5e7eb;
    }

    .mini-event-list {
      display: grid;
      gap: 0.75rem;
      margin-top: 0.75rem;
    }

    .mini-event {
      display: flex;
      gap: 0.8rem;
      align-items: center;
      padding: 0.6rem;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      background: #fafafa;
    }

    .mini-event__thumb {
      width: 54px;
      height: 54px;
      border-radius: 12px;
      background: linear-gradient(135deg, #dbeafe, #e0e7ff);
      display: grid;
      place-items: center;
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      color: #3b4fb5;
      flex-shrink: 0;
    }

    .mini-event strong {
      display: block;
      margin-bottom: 0.2rem;
    }

    .mini-event p {
      margin: 0;
      color: #4b5563;
      font-size: 0.82rem;
    }
  </style>
</AppLayout>
