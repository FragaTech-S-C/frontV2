---
import AppLayout from '@/layouts/AppLayout.astro';
export function getStaticPaths() { return [{ params: { id: '_' } }]; }
const { id } = Astro.params;
---
<AppLayout title="Grupo">
  <div id="group-status" class="box" style="display:none;"></div>
  <div id="group-shell" style="display:none;"></div>
</AppLayout>

<script>
  import { api, getStoredAuth } from '@/lib/api';
  const groupId = window.location.pathname.split('/').filter(Boolean)[1];

  const statusEl = document.getElementById('group-status');
  const shell = document.getElementById('group-shell');

  const show = (msg) => { if (statusEl) { statusEl.style.display = 'block'; statusEl.textContent = msg; } };
  const hide = () => { if (statusEl) statusEl.style.display = 'none'; };

  const formatDate = (v) => {
    if (!v) return 'Sin fecha';
    const d = new Date(v);
    if (isNaN(d)) return 'Sin fecha';
    return new Intl.DateTimeFormat('es-AR', { day:'2-digit', month:'2-digit', year:'numeric' }).format(d);
  };

  const currentUser = () => {
    const a = getStoredAuth();
    return a?.user ?? a ?? null;
  };

  const load = async () => {
    show('Cargando grupo...');
    try {
      const group = await api.getGroupById(groupId);
      hide();
      if (!shell) return;
      shell.style.display = 'block';

      const user = currentUser();
      const isOwner = user && (group.ownerId === (user.id ?? user._id));

      const coverHTML = group.coverImage
        ? `<img src="${group.coverImage}" alt="${group.name}" style="display:block;width:100%;max-height:240px;object-fit:cover;" />`
        : `<div style="width:100%;height:160px;background:linear-gradient(135deg,#eaf0ff,#eefbf6);display:grid;place-items:center;font-weight:700;font-size:1.1rem;color:#4b5b9d;text-transform:uppercase;letter-spacing:0.08em;">Portada del grupo</div>`;

      const avatarHTML = group.avatar
        ? `<img src="${group.avatar}" alt="${group.name}" style="width:72px;height:72px;border-radius:50%;object-fit:cover;" />`
        : `<div style="width:72px;height:72px;border-radius:50%;background:#dfe6ff;color:#2f5d8a;font-weight:700;font-size:1.5rem;display:grid;place-items:center;">${(group.name ?? 'G').charAt(0).toUpperCase()}</div>`;

      const members = Array.isArray(group.members) ? group.members : [];
      const events = Array.isArray(group.events) ? group.events : [];
      const memberCount = group._count?.members ?? members.length;

      const memberPills = members.slice(0, 12).map((m) => {
        const name = `${m.firstName ?? ''} ${m.lastName ?? ''}`.trim() || m.email || m.id;
        return `<div style="padding:0.4rem 0.75rem;border-radius:999px;background:#eef2ff;color:#3749b8;font-size:0.85rem;font-weight:600;">${name}</div>`;
      }).join('');

      const eventCards = events.slice(0, 6).map((ev) => `
        <article style="display:flex;gap:0.75rem;align-items:center;padding:0.6rem;border:1px solid #e5e7eb;border-radius:12px;background:#fafafa;">
          <div style="width:52px;height:52px;border-radius:10px;background:linear-gradient(135deg,#dbeafe,#e0e7ff);display:grid;place-items:center;font-size:0.65rem;font-weight:700;text-transform:uppercase;color:#3b4fb5;flex-shrink:0;">${ev.category ?? 'EVT'}</div>
          <div>
            <a href="/events/${ev.id}" style="font-weight:600;color:#111827;text-decoration:none;">${ev.title ?? 'Evento'}</a>
            <p style="margin:0.2rem 0 0;font-size:0.82rem;color:#4b5563;">${formatDate(ev.startDate)}</p>
          </div>
        </article>
      `).join('');

      shell.innerHTML = `
        <section class="box" style="overflow:hidden;padding:0;">
          ${coverHTML}
          <div style="padding:1.25rem;">
            <div style="display:flex;align-items:center;gap:1rem;margin-bottom:0.75rem;">
              ${avatarHTML}
              <div>
                <h2 style="margin:0 0 0.25rem;font-size:1.5rem;">${group.name ?? 'Grupo'}</h2>
                <p style="margin:0;color:#4b5563;font-size:0.9rem;">${group.isPrivate ? 'Privado' : 'Público'} · ${memberCount} miembro${memberCount !== 1 ? 's' : ''}</p>
              </div>
            </div>
            ${group.description ? `<p style="color:#374151;margin-bottom:1rem;">${group.description}</p>` : ''}
            <div class="row">
              <a class="btn" href="/events/new">+ Crear evento</a>
              ${!isOwner ? `<button class="btn out" id="join-btn" type="button">Unirse al grupo</button>` : ''}
              ${isOwner ? `<a class="btn out" id="edit-group-btn" href="#">Editar grupo</a>` : ''}
              ${isOwner ? `<button class="btn out" id="delete-group-btn" type="button" style="border-color:#ef4444;color:#ef4444;">Eliminar</button>` : ''}
            </div>
          </div>
        </section>

        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1rem;margin-top:1rem;">
          <section class="box">
            <h3>Información</h3>
            <div style="display:flex;justify-content:space-between;padding:0.6rem 0;border-bottom:1px solid #e5e7eb;"><span>Miembros</span><strong>${memberCount}</strong></div>
            <div style="display:flex;justify-content:space-between;padding:0.6rem 0;border-bottom:1px solid #e5e7eb;"><span>Privacidad</span><strong>${group.isPrivate ? 'Privado' : 'Público'}</strong></div>
            <div style="display:flex;justify-content:space-between;padding:0.6rem 0;"><span>Requiere aprobación</span><strong>${group.requiresApproval ? 'Sí' : 'No'}</strong></div>
          </section>

          <section class="box">
            <h3>Miembros (${memberCount})</h3>
            <div style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-top:0.75rem;">${memberPills || '<p class="muted">Sin miembros listados.</p>'}</div>
          </section>

          <section class="box">
            <h3>Chat del grupo</h3>
            <p class="muted">Próximamente: mensajería interna del grupo.</p>
            <div style="margin-top:1rem;min-height:100px;border:1px dashed #bac5dd;border-radius:10px;display:grid;place-items:center;color:#64748b;font-size:0.9rem;">Chat en construcción</div>
          </section>
        </div>

        <section class="box" style="margin-top:1rem;">
          <h3>Eventos del grupo</h3>
          <div style="display:grid;gap:0.75rem;margin-top:0.75rem;">${eventCards || '<p class="muted">No hay eventos en este grupo.</p>'}</div>
        </section>
        <p id="action-status" class="muted" style="margin-top:0.5rem;"></p>
      `;

      // Bind join button
      const joinBtn = document.getElementById('join-btn');
      joinBtn?.addEventListener('click', async () => {
        joinBtn.disabled = true;
        try {
          await api.joinGroup(groupId);
          joinBtn.textContent = '✔ Solicitud enviada / Unido';
        } catch (e) {
          const as = document.getElementById('action-status');
          if (as) as.textContent = e instanceof Error ? e.message : 'No se pudo unirse.';
          joinBtn.disabled = false;
        }
      });

      // Edit group link
      const editBtn = document.getElementById('edit-group-btn');
      // (edit page not yet created — just point to groups page for now)
      if (editBtn) editBtn.href = `/groups`;

      // Delete group
      const deleteBtn = document.getElementById('delete-group-btn');
      deleteBtn?.addEventListener('click', async () => {
        if (!confirm('¿Eliminar el grupo? Esta acción no se puede deshacer.')) return;
        deleteBtn.disabled = true;
        try {
          await api.deleteGroup(groupId);
          window.location.href = '/groups';
        } catch (e) {
          const as = document.getElementById('action-status');
          if (as) as.textContent = e instanceof Error ? e.message : 'No se pudo eliminar.';
          deleteBtn.disabled = false;
        }
      });

    } catch (err) {
      show(err instanceof Error ? err.message : 'No se pudo cargar el grupo.');
    }
  };

  load();
</script>
