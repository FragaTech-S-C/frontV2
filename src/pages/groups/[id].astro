---
import AppLayout from '@/layouts/AppLayout.astro';
---

<AppLayout title="Grupo">
  <div id="group-shell"></div>

  <script>
    import { api } from '@/lib/api';

    const shell = document.getElementById('group-shell');
    if (!shell) throw new Error('Missing group shell');

    const currentPath = window.location.pathname.split('/').filter(Boolean).pop() || '';
    const groupId = decodeURIComponent(currentPath);

    const loadGroup = async () => {
      try {
        const groups = await api.getGroups();
        const group = (Array.isArray(groups) ? groups : []).find((item) => String(item.id) === String(groupId)) || null;

        if (!group) {
          shell.innerHTML = `
            <div class="box">
              <h2>Grupo no encontrado</h2>
              <p>No tenés acceso a este grupo o aún no fue invitado a él.</p>
              <a class="btn" href="/groups">Volver a mis grupos</a>
            </div>
          `;
          return;
        }

        const members = Array.isArray(group.members) ? group.members as Array<Record<string, any>> : [];
        const events = Array.isArray(group.events) ? group.events as Array<Record<string, any>> : [];
        const cover = group.coverImage
          ? `<img src="${group.coverImage}" alt="${group.name || 'Grupo'}" class="group-cover" />`
          : '<div class="group-cover placeholder">Portada del grupo</div>';
        const avatar = group.avatar
          ? `<img src="${group.avatar}" alt="${group.name || 'Grupo'}" class="group-avatar" />`
          : `<div class="group-avatar letter">${(group.name || 'G').charAt(0).toUpperCase()}</div>`;
        const memberList = members.map((member: Record<string, any>) => `<div class="member-pill">${member.firstName || member.nickname || 'Usuario'}</div>`).join('');
        const eventList = events.map((event: Record<string, any>) => {
          const date = event.startDate ? new Date(event.startDate) : null;
          const formattedDate = date && !Number.isNaN(date.getTime()) ? new Intl.DateTimeFormat('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(date) : 'Sin fecha';
          return `
            <article class="mini-event">
              <div class="mini-event__thumb">${event.category || 'Evento'}</div>
              <div>
                <strong>${event.title || 'Evento sin título'}</strong>
                <p>${formattedDate}</p>
                <p>${event.location || event.city || 'Sin ubicación'}</p>
              </div>
            </article>
          `;
        }).join('');

        shell.innerHTML = `
          <section class="box group-header">
            ${cover}
            <div class="group-summary">
              <div class="group-title-row">
                ${avatar}
                <div>
                  <h2>${group.name || 'Grupo sin nombre'}</h2>
                  <p>${group.institutionId ? 'Grupo institucional' : 'Grupo personal'} · ${group.owner?.firstName || 'Líder'}</p>
                </div>
              </div>
              <p>${group.description || 'Sin descripción aún.'}</p>
              <div class="row">
                <a class="btn" href="/events/new?groupId=${encodeURIComponent(group.id || '')}">Crear evento</a>
              </div>
            </div>
          </section>

          <div class="group-grid">
            <section class="box">
              <h3>Administrar grupo</h3>
              <div class="status-row">
                <span>Miembros</span>
                <strong>${members.length}</strong>
              </div>
              <div class="status-row">
                <span>Privacidad</span>
                <strong>${group.institutionId ? 'Institucional' : 'Personal'}</strong>
              </div>
              <div class="status-row">
                <span>Estado</span>
                <strong>Activo</strong>
              </div>
            </section>

            <section class="box">
              <h3>Crear nuevo evento</h3>
              <p>Prepará una nueva actividad para este grupo.</p>
              <a class="btn" href="/events/new?groupId=${encodeURIComponent(group.id || '')}">Ir al formulario</a>
            </section>

            <section class="box">
              <h3>Miembros</h3>
              <div class="member-list">${memberList || '<p>No hay miembros aún.</p>'}</div>
            </section>

            <section class="box">
              <h3>Añadir personas</h3>
              <input id="group-member-search" type="search" placeholder="Buscar por email" autocomplete="off" style="width:100%;margin-bottom:0.75rem;" />
              <div id="group-member-results" style="display:grid; gap:0.5rem;"></div>
            </section>

            <section class="box events-box">
              <h3>Eventos del grupo</h3>
              <div class="mini-event-list">${eventList || '<p>No hay eventos creados.</p>'}</div>
            </section>
          </div>
        `;

        const groupMemberSearch = document.getElementById('group-member-search') as HTMLInputElement | null;
        const groupMemberResults = document.getElementById('group-member-results') as HTMLDivElement | null;
        const storedAuth = JSON.parse(localStorage.getItem('meetia-auth') || '{}');
        const currentUserId = storedAuth?.user?.id ?? storedAuth?.id ?? storedAuth?.userId ?? localStorage.getItem('meetia-user-id');

        const renderGroupMemberSearch = async () => {
          if (!groupMemberSearch || !groupMemberResults) return;
          const query = String(groupMemberSearch.value || '').trim();

          if (!query) {
            groupMemberResults.innerHTML = '<span>Escribí un email para buscar personas.</span>';
            return;
          }

          try {
            const users = await api.searchUsersByEmail(query);
            const visibleUsers = Array.isArray(users) ? users.filter((user) => String(user.id) !== String(currentUserId)) : [];
            if (!visibleUsers.length) {
              groupMemberResults.innerHTML = '<span>No se encontraron personas.</span>';
              return;
            }

            groupMemberResults.innerHTML = visibleUsers.slice(0, 6).map((user) => `
              <button type="button" class="btn out" data-user-id="${user.id}" style="justify-content:flex-start; width:100%;">
                ${user.firstName || user.nickname || 'Usuario'} ${user.lastName || ''} (@${user.nickname || user.email || 'sin-nick'})
              </button>
            `).join('');

            groupMemberResults.querySelectorAll<HTMLButtonElement>('[data-user-id]').forEach((button) => {
              button.addEventListener('click', async () => {
                const userId = button.getAttribute('data-user-id');
                if (!userId) return;

                try {
                  await api.addMemberToGroup(group.id, userId);
                  groupMemberSearch.value = '';
                  await loadGroup();
                } catch (error) {
                  const message = error instanceof Error ? error.message : 'No se pudo agregar la persona.';
                  groupMemberResults.innerHTML = `<span>${message}</span>`;
                }
              });
            });
          } catch (error) {
            groupMemberResults.innerHTML = '<span>No se pudo buscar usuarios.</span>';
          }
        };

        if (groupMemberSearch) {
          groupMemberSearch.addEventListener('input', () => {
            void renderGroupMemberSearch();
          });
        }
        void renderGroupMemberSearch();
      } catch (error) {
        shell.innerHTML = `
          <div class="box">
            <h2>No se pudo cargar el grupo</h2>
            <p>${error instanceof Error ? error.message : 'Intentalo nuevamente más tarde.'}</p>
            <a class="btn" href="/groups">Volver a mis grupos</a>
          </div>
        `;
      }
    };

    loadGroup();
  </script>

  <style>
    .group-header {
      overflow: hidden;
      padding: 0;
    }

    .group-cover {
      display: block;
      width: 100%;
      height: 220px;
      object-fit: cover;
      background: #dfe7ff;
    }

    .group-cover.placeholder {
      display: grid;
      place-items: center;
      background: linear-gradient(135deg, #eaf0ff, #eefbf6);
      color: #4b5b9d;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .group-summary {
      padding: 1.25rem 1.25rem 1.4rem;
    }

    .group-title-row {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 0.75rem;
    }

    .group-avatar {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      object-fit: cover;
      background: #e6e7ff;
      display: block;
    }

    .group-avatar.letter {
      display: grid;
      place-items: center;
      background: #dfe6ff;
      color: #2f5d8a;
      font-weight: 700;
      font-size: 1.5rem;
    }

    .group-summary h2 {
      margin: 0 0 0.25rem;
      font-size: 1.6rem;
    }

    .group-summary p {
      color: #4b5563;
    }

    .group-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1rem;
      margin-top: 1.25rem;
    }

    .status-row {
      display: flex;
      justify-content: space-between;
      padding: 0.7rem 0;
      border-bottom: 1px solid #e5e7eb;
      color: #374151;
    }

    .member-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin: 0.75rem 0 1rem;
    }

    .member-pill {
      border-radius: 999px;
      background: #eef2ff;
      color: #3749b8;
      padding: 0.45rem 0.75rem;
      font-size: 0.85rem;
      font-weight: 600;
    }

    .chat-placeholder {
      margin-top: 1rem;
      min-height: 130px;
      border: 1px dashed #bac5dd;
      border-radius: 12px;
      display: grid;
      place-items: center;
      background: #f8fafc;
      color: #64748b;
      font-weight: 600;
    }

    .mini-event-list {
      display: grid;
      gap: 0.75rem;
      margin-top: 0.75rem;
    }

    .mini-event {
      display: flex;
      gap: 0.8rem;
      align-items: center;
      padding: 0.6rem;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      background: #fafafa;
    }

    .mini-event__thumb {
      width: 54px;
      height: 54px;
      border-radius: 12px;
      background: linear-gradient(135deg, #dbeafe, #e0e7ff);
      display: grid;
      place-items: center;
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      color: #3b4fb5;
      flex-shrink: 0;
    }

    .mini-event strong {
      display: block;
      margin-bottom: 0.2rem;
    }

    .mini-event p {
      margin: 0;
      color: #4b5563;
      font-size: 0.82rem;
    }
  </style>
</AppLayout>
