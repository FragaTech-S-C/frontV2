---
import AppLayout from '@/layouts/AppLayout.astro';
---
<AppLayout title="Nuevo grupo">
  <form id="group-form" class="box">
    <label>Nombre<input name="name" required /></label>
    <label>Descripción<textarea name="description" rows="4"></textarea></label>

    <div class="row">
      <label class="grow">Tipo
        <select name="type">
          <option value="personal">Personal</option>
          <option value="institutional">Institucional</option>
        </select>
      </label>
      <!-- <label class="grow">Líder<input name="leader" value="Yo" readonly /></label> -->
    </div>

    <div id="group-institutional-fields" style="display:none;">
      <label>Institución asociada
        <select name="institutionId">
          <option value="">Seleccioná una institución</option>
          <option value="inst-1">Universidad del Este</option>
          <option value="inst-2">Fundación Innovar</option>
          <option value="inst-3">Museo de Arte</option>
        </select>
      </label>
    </div>

    <div class="box" style="padding:0.75rem; margin:0.75rem 0;">
      <label>
        Buscar miembro por nick
        <input id="member-search" type="search" placeholder="Ej: ana, mate, lu" />
      </label>
      <div id="member-results" style="display:grid; gap:0.5rem; margin-top:0.5rem;" /></div>
      <div id="selected-members" style="display:flex; flex-wrap:wrap; gap:0.5rem; margin-top:0.75rem;"></div>
    </div>

    <label>Imagen del grupo<input type="file" name="avatar" accept="image/*" /></label>
    <label>Portada del grupo<input type="file" name="coverImage" accept="image/*" /></label>

    <div class="row">
      <button class="btn" type="submit">Crear grupo</button>
      <a class="btn out" href="/groups">Cancelar</a>
    </div>
    <p id="group-status" aria-live="polite"></p>
  </form>

  <script>
    const form = document.getElementById('group-form') as HTMLFormElement;
    const statusBox = document.getElementById('group-status');
    const typeField = form?.querySelector('select[name="type"]');
    const institutionalFields = document.getElementById('group-institutional-fields');
    const leaderInput = form?.querySelector('input[name="leader"]') as HTMLInputElement | null;
    const memberSearch = document.getElementById('member-search');
    const memberResults = document.getElementById('member-results');
    const selectedMembersWrap = document.getElementById('selected-members');
    let selectedMembers: Array<Record<string, any>> = [];

    let storedUser: Record<string, any> = {};
    try {
      storedUser = JSON.parse(localStorage.getItem('meetia-auth') || '{}') as Record<string, any>;
    } catch {
      storedUser = {};
    }

    const currentUserId = storedUser?.user?.id ?? storedUser?.id ?? storedUser?.userId ?? localStorage.getItem('meetia-user-id') ?? 'local-user';
    const currentUserName = storedUser?.user?.name ?? storedUser?.name ?? storedUser?.fullName ?? 'Yo';

    if (leaderInput) {
      leaderInput.value = currentUserName;
    }

    const toggleInstitutionalFields = () => {
      const isInstitutional = String(typeField ?? 'personal') === 'institutional';
      if (institutionalFields) {
        institutionalFields.style.display = isInstitutional ? 'block' : 'none';
      }
    };

    const readFile = (file: File) => {
      if (!file) return Promise.resolve(undefined);
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(String(reader.result || ''));
        reader.onerror = () => reject(new Error('No se pudo leer la imagen.'));
        reader.readAsDataURL(file);
      });
    };

    const slugify = (value: string) =>
      value
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '') || 'grupo';

    const renderMemberSuggestions = () => {
      const users: Array<Record<string, any>> = JSON.parse(localStorage.getItem('meetia-users') || '[]');
      const query = String((memberSearch as HTMLInputElement | null)?.value || '').trim().toLowerCase();
      const visibleUsers = users.filter((user: Record<string, any>) => {
        const text = `${user.nickname || ''} ${user.name || ''}`.toLowerCase();
        return !query || text.includes(query);
      }).slice(0, 5);

      if (!memberResults) return;
      memberResults.innerHTML = visibleUsers.length
        ? visibleUsers.map((user) => `
            <button type="button" class="btn out" data-member-id="${user.id}" style="justify-content:flex-start; width:100%;">
              ${user.name} (@${user.nickname || 'sin-nick'})
            </button>
          `).join('')
        : '<span>No se encontraron usuarios.</span>';

      memberResults.querySelectorAll('[data-member-id]').forEach((button) => {
        button.addEventListener('click', () => {
          const id = button.getAttribute('data-member-id');
          const user = users.find((item: Record<string, any>) => String(item.id) === String(id));
          if (!user) return;
          if (!selectedMembers.some((item) => String(item.id) === String(user.id))) {
            selectedMembers = [...selectedMembers, user];
          }
          renderSelectedMembers();
        });
      });
    };

    const renderSelectedMembers = () => {
      if (!selectedMembersWrap) return;
      selectedMembersWrap.innerHTML = selectedMembers.length
        ? selectedMembers.map((member) => `
            <span class="member-pill">${member.name} (@${member.nickname || 'sin-nick'})</span>
          `).join('')
        : '<span>Sin invitados aún.</span>';
    };

    memberSearch?.addEventListener('input', renderMemberSuggestions);
    renderMemberSuggestions();
    renderSelectedMembers();
    typeField?.addEventListener('change', toggleInstitutionalFields);
    toggleInstitutionalFields();

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(form);
      const type = String(formData.get('type') ?? 'personal');
      const name = String(formData.get('name') ?? '').trim();
      const description = String(formData.get('description') ?? '').trim();
      const institutionId = String(formData.get('institutionId') ?? '').trim();
      const avatarFile = formData.get('avatar');
      const coverImageFile = formData.get('coverImage');

      if (!name) {
        if (statusBox) {
          statusBox.textContent = 'El nombre del grupo es obligatorio.';
        }
        return;
      }

      if (type === 'institutional' && !institutionId) {
        if (statusBox) {
          statusBox.textContent = 'Seleccioná la institución para el grupo institucional.';
        }
        return;
      }

      const avatar = avatarFile && avatarFile instanceof File ? await readFile(avatarFile) : undefined;
      const coverImage = coverImageFile && coverImageFile instanceof File ? await readFile(coverImageFile) : undefined;
      const groups: Array<Record<string, any>> = JSON.parse(localStorage.getItem('meetia-groups') || '[]');
      const baseSlug = slugify(name);
      const usedSlugs = new Set((groups || []).map((item: Record<string, any>) => String(item.slug || slugify(item.name || '')).toLowerCase()));
      let slug = baseSlug;
      let counter = 2;

      while (usedSlugs.has(slug)) {
        slug = `${baseSlug}-${counter}`;
        counter += 1;
      }

      const nextGroup = {
        id: String(Date.now()),
        slug,
        name,
        description,
        type,
        institutionId: type === 'institutional' ? institutionId : undefined,
        ownerId: currentUserId,
        leader: currentUserName,
        leader_user_id: currentUserId,
        avatar,
        coverImage,
        members: selectedMembers.map((member) => `${member.name} (@${member.nickname || 'sin-nick'})`),
        createdAt: new Date().toISOString(),
      };

      const notifications = JSON.parse(localStorage.getItem('meetia-notifications') || '[]');
      const inviteNotifications = selectedMembers.map((member) => ({
        title: 'Invitación al grupo',
        text: `${currentUserName} te invitó a unirte a ${name}.`,
        memberId: member.id,
      }));
      localStorage.setItem('meetia-notifications', JSON.stringify([...inviteNotifications, ...notifications].slice(0, 12)));
      localStorage.setItem('meetia-groups', JSON.stringify([...groups, nextGroup]));
      window.location.href = `/groups/${slug}`;
    });
  </script>
</AppLayout>
