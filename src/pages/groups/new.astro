---
import AppLayout from '@/layouts/AppLayout.astro';
---
<AppLayout title="Nuevo grupo">
  <form id="group-form" class="box">
    <label>Nombre <span style="color:#b91c1c">*</span><input name="name" required /></label>
    <label>Descripción<textarea name="description" rows="3"></textarea></label>

    <div class="row">
      <label class="grow">¿Es privado?
        <select name="isPrivate">
          <option value="false">No (público)</option>
          <option value="true">Sí (privado)</option>
        </select>
      </label>
      <label class="grow">¿Requiere aprobación?
        <select name="requiresApproval">
          <option value="false">No</option>
          <option value="true">Sí</option>
        </select>
      </label>
    </div>

    <label>Institución asociada (opcional)
      <select name="institutionId" id="institution-select">
        <option value="">Sin institución</option>
      </select>
    </label>

    <label>URL de imagen del grupo (opcional)<input type="url" name="avatar" placeholder="https://..." /></label>
    <label>URL de portada del grupo (opcional)<input type="url" name="coverImage" placeholder="https://..." /></label>

    <div class="row">
      <button class="btn" type="submit">Crear grupo</button>
      <a class="btn out" href="/groups">Cancelar</a>
    </div>
    <p id="group-status" aria-live="polite" class="muted"></p>
  </form>
</AppLayout>

<script>
  import { api } from '@/lib/api';

  const form = document.getElementById('group-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('group-status');
  const institutionSelect = document.getElementById('institution-select') as HTMLSelectElement | null;

  // Load institutions for the dropdown
  const loadInstitutions = async () => {
    try {
      const data = await api.getInstitutions();
      const items = Array.isArray(data) ? data : (data?.institutions ?? data?.data ?? []);
      items.forEach((inst) => {
        const opt = document.createElement('option');
        opt.value = inst.id;
        opt.textContent = inst.name;
        institutionSelect?.appendChild(opt);
      });
    } catch {
      // Not critical — institutions list is optional
    }
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const name = String(fd.get('name') ?? '').trim();

    if (!name) {
      if (statusEl) statusEl.textContent = 'El nombre del grupo es obligatorio.';
      return;
    }

    if (statusEl) statusEl.textContent = 'Creando grupo...';

    const payload = {
      name,
      description: String(fd.get('description') ?? '').trim() || undefined,
      isPrivate: fd.get('isPrivate') === 'true',
      requiresApproval: fd.get('requiresApproval') === 'true',
      institutionId: String(fd.get('institutionId') ?? '').trim() || undefined,
      avatar: String(fd.get('avatar') ?? '').trim() || undefined,
      coverImage: String(fd.get('coverImage') ?? '').trim() || undefined,
    };

    try {
      const group = await api.createGroup(payload);
      const groupId = group?.id ?? group?.group?.id;
      if (groupId) {
        window.location.href = `/groups/${groupId}`;
      } else {
        window.location.href = '/groups';
      }
    } catch (err) {
      if (statusEl) statusEl.textContent = err instanceof Error ? err.message : 'No se pudo crear el grupo.';
    }
  });

  loadInstitutions();
</script>
