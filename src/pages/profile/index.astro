---
import AppLayout from '@/layouts/AppLayout.astro';
---
<AppLayout title="Mi perfil">
  <div id="profile-status" class="box" style="display:none;"></div>

  <form id="profile-form" class="box" style="display:none;">
    <!-- Avatar -->
    <div style="display:flex;align-items:center;gap:1rem;margin-bottom:0.5rem;">
      <div id="profile-avatar"
        style="width:80px;height:80px;border-radius:50%;background:#e6e7ff;display:grid;place-items:center;font-size:1.8rem;font-weight:700;color:#2f5d8a;overflow:hidden;flex-shrink:0;">
        ?
      </div>
      <div style="flex:1;">
        <label style="margin:0;">
          URL de foto de perfil
          <input id="avatar-url" name="avatar" type="url" placeholder="https://…" />
        </label>
        <button type="button" id="preview-avatar-btn" class="btn out" style="margin-top:0.5rem;padding:0 12px;min-height:36px;font-size:13px;">Vista previa</button>
      </div>
    </div>

    <div class="row">
      <label class="grow">Nombre<input id="firstName" name="firstName" /></label>
      <label class="grow">Apellido<input id="lastName" name="lastName" /></label>
    </div>
    <label>Email<input id="email" name="email" type="email" readonly style="background:#f0f0f0;cursor:not-allowed;" /></label>
    <label>Teléfono<input id="phone" name="phone" type="tel" placeholder="Opcional" /></label>
    <label>Apodo<input id="nickname" name="nickname" placeholder="Opcional" /></label>

    <h3 style="margin-top:0.5rem;">Cambiar contraseña</h3>
    <div class="row">
      <label class="grow">Contraseña actual<input type="password" name="currentPassword" autocomplete="current-password" /></label>
      <label class="grow">Nueva contraseña<input type="password" name="newPassword" autocomplete="new-password" /></label>
    </div>

    <div class="row" style="margin-top:0.5rem;">
      <button class="btn" type="submit">Guardar cambios</button>
      <a class="btn out" href="/profile/friends">Ver amigos</a>
    </div>
    <p id="save-status" aria-live="polite" class="muted" style="margin-top:0.25rem;"></p>
  </form>
</AppLayout>

<script>
  import { api, setStoredAuth, getStoredAuth } from '@/lib/api';

  const profileStatus = document.getElementById('profile-status');
  const form = document.getElementById('profile-form') as HTMLFormElement | null;
  const saveStatus = document.getElementById('save-status');
  const avatarEl = document.getElementById('profile-avatar');
  const avatarUrlInput = document.getElementById('avatar-url') as HTMLInputElement | null;
  const previewBtn = document.getElementById('preview-avatar-btn');

  const showPage = (msg: string) => {
    if (profileStatus) { profileStatus.style.display = 'block'; profileStatus.textContent = msg; }
  };

  const applyAvatar = (url: string, initial: string) => {
    if (!avatarEl) return;
    if (url) {
      avatarEl.style.backgroundImage = `url(${url})`;
      avatarEl.style.backgroundSize = 'cover';
      avatarEl.style.backgroundPosition = 'center';
      avatarEl.textContent = '';
    } else {
      avatarEl.style.backgroundImage = 'none';
      avatarEl.textContent = initial.toUpperCase();
    }
  };

  previewBtn?.addEventListener('click', () => {
    const url = avatarUrlInput?.value?.trim() ?? '';
    applyAvatar(url, (document.getElementById('firstName') as HTMLInputElement)?.value?.[0] ?? '?');
  });

  const fillForm = (user: Record<string, unknown>) => {
    const setVal = (id: string, val: unknown) => {
      const el = document.getElementById(id) as HTMLInputElement | null;
      if (el) el.value = String(val ?? '');
    };
    setVal('firstName', user.firstName);
    setVal('lastName', user.lastName);
    setVal('email', user.email);
    setVal('phone', user.phone);
    setVal('nickname', user.nickname);
    if (avatarUrlInput) avatarUrlInput.value = String(user.avatar ?? '');
    applyAvatar(
      String(user.avatar ?? ''),
      String(user.firstName?.[0] ?? user.email?.[0] ?? '?'),
    );
  };

  const load = async () => {
    showPage('Cargando perfil…');
    try {
      const user = await api.me() as Record<string, unknown>;
      if (profileStatus) profileStatus.style.display = 'none';
      if (form) form.style.display = 'flex';
      fillForm(user);
    } catch (err) {
      showPage(err instanceof Error ? err.message : 'No se pudo cargar el perfil.');
    }
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (saveStatus) saveStatus.textContent = 'Guardando…';

    const fd = new FormData(form);
    const currentPassword = String(fd.get('currentPassword') ?? '').trim();
    const newPassword = String(fd.get('newPassword') ?? '').trim();

    const profilePayload: Record<string, unknown> = {
      firstName: String(fd.get('firstName') ?? '').trim() || undefined,
      lastName: String(fd.get('lastName') ?? '').trim() || undefined,
      phone: String(fd.get('phone') ?? '').trim() || undefined,
      nickname: String(fd.get('nickname') ?? '').trim() || undefined,
      avatar: String(fd.get('avatar') ?? '').trim() || undefined,
    };

    try {
      const updated = await api.updateProfile(profilePayload) as Record<string, unknown>;
      fillForm(updated);

      // Update stored auth with new user data
      const stored = getStoredAuth();
      if (stored) setStoredAuth({ ...stored, user: { ...(stored.user ?? {}), ...updated } });

      // Change password if provided
      if (currentPassword && newPassword) {
        await api.resetPassword({ currentPassword, newPassword });
        // Clear password fields
        (form.querySelector('[name="currentPassword"]') as HTMLInputElement).value = '';
        (form.querySelector('[name="newPassword"]') as HTMLInputElement).value = '';
      }

      if (saveStatus) saveStatus.textContent = 'Perfil actualizado correctamente.';
    } catch (err) {
      if (saveStatus) saveStatus.textContent = err instanceof Error ? err.message : 'No se pudo guardar.';
    }
  });

  load();
</script>
