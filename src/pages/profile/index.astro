---
import AppLayout from '@/layouts/AppLayout.astro';
---

<AppLayout title="Mi perfil">
  <form id="profile-form" class="box">
    <div class="ph" id="profile-avatar" style="max-width:120px;min-height:120px;display:grid;place-items:center;">Avatar</div>

    <label>Nombre<input id="firstName" name="firstName" /></label>
    <label>Apellido<input id="lastName" name="lastName" /></label>
    <label>Nickname<input id="nickname" name="nickname" /></label>
    <label>Email<input id="email" name="email" type="email" readonly /></label>
    <label>Teléfono<input id="phone" name="phone" type="tel" placeholder="Opcional" /></label>
    <label>Foto de perfil<input id="avatar-file" name="avatar-file" type="file" accept="image/*" /></label>
    <label>URL opcional<input id="avatar-url" name="avatar-url" type="url" placeholder="https://..." /></label>

    <h3>Intereses</h3>
    <div class="ph">Categorías seleccionables</div>

    <div class="row">
      <button class="btn" type="submit">Guardar cambios</button>
      <button class="btn out" type="button" id="reset-password-button">Restablecer contraseña</button>
      <a class="btn out" href="/profile/friends">Ver amigos</a>
    </div>
    <p id="profile-status" aria-live="polite"></p>
  </form>

  <script>
    import { api, setStoredAuth } from '@/lib/api';

    const profileForm = document.getElementById('profile-form');
    const statusEl = document.getElementById('profile-status');
    const firstName = document.getElementById('firstName') as HTMLInputElement | null;
    const lastName = document.getElementById('lastName') as HTMLInputElement | null;
    const nickname = document.getElementById('nickname') as HTMLInputElement | null;
    const email = document.getElementById('email') as HTMLInputElement | null;
    const phone = document.getElementById('phone') as HTMLInputElement | null;
    const avatarFile = document.getElementById('avatar-file') as HTMLInputElement | null;
    const avatarUrl = document.getElementById('avatar-url') as HTMLInputElement | null;
    const avatarPreview = document.getElementById('profile-avatar');

    const readImageFile = (file: File) => {
      if (!file) return Promise.resolve('');
      return new Promise<string>((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(String(reader.result || ''));
        reader.onerror = () => reject(new Error('No se pudo leer la imagen.'));
        reader.readAsDataURL(file);
      });
    };

    const applyAvatar = (avatarValue: string) => {
      if (!avatarPreview) return;

      if (avatarValue) {
        avatarPreview.textContent = '';
        avatarPreview.style.backgroundImage = `url(${avatarValue})`;
        avatarPreview.style.backgroundSize = 'cover';
        avatarPreview.style.backgroundPosition = 'center';
        return;
      }

      avatarPreview.textContent = firstName?.value?.[0] || email?.value?.[0] || 'U';
      avatarPreview.style.backgroundImage = 'none';
    };

    const fillProfile = (user: Record<string, any>) => {
      if (!user) return;
      if (firstName) firstName.value = user.firstName ?? '';
      if (lastName) lastName.value = user.lastName ?? '';
      if (nickname) nickname.value = user.nickname ?? '';
      if (email) email.value = user.email ?? '';
      if (phone) phone.value = user.phone ?? '';
      if (avatarUrl) avatarUrl.value = user.avatar ?? '';
      applyAvatar(String(user.avatar ?? ''));
    };

    avatarFile?.addEventListener('change', async (event) => {
      const target = event.target as HTMLInputElement | null;
      const file = target?.files?.[0];
      if (!file) return;
      const imageData = await readImageFile(file);
      if (avatarUrl) avatarUrl.value = String(imageData || '');
      applyAvatar(String(imageData || ''));
    });

    const loadProfile = async () => {
      try {
        const user = await api.me();
        fillProfile(user);
      } catch (error) {
        if (statusEl) {
          statusEl.textContent = error instanceof Error ? error.message : 'No se pudo cargar el perfil.';
        }
      }
    };

    profileForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (statusEl) statusEl.textContent = 'Guardando cambios...';

      try {
        const avatarValue = (avatarUrl?.value ?? '').trim();
        const firstNameValue = firstName?.value.trim() ?? '';
        const lastNameValue = lastName?.value.trim() ?? '';
        const nicknameValue = nickname?.value.trim() ?? '';
        const phoneValue = phone?.value.trim() ?? '';
        const payload = {
          firstName: firstNameValue || undefined,
          lastName: lastNameValue || undefined,
          nickname: nicknameValue || undefined,
          phone: phoneValue || undefined,
          avatar: avatarValue || undefined,
        };

        const updatedUser = await api.updateProfile(payload);
        fillProfile(updatedUser);

        const storedAuth = JSON.parse(localStorage.getItem('meetia-auth') || '{}');
        setStoredAuth({ ...storedAuth, user: { ...(storedAuth.user || {}), ...updatedUser } });

        if (statusEl) statusEl.textContent = 'Perfil actualizado correctamente.';
      } catch (error) {
        if (statusEl) {
          statusEl.textContent = error instanceof Error ? error.message : 'No se pudo guardar el perfil.';
        }
      }
    });

    document.getElementById('reset-password-button')?.addEventListener('click', async () => {
      const currentPassword = window.prompt('Ingresá tu contraseña actual');
      if (!currentPassword) return;
      const newPassword = window.prompt('Ingresá la nueva contraseña');
      if (!newPassword) return;
      try {
        await api.resetPassword(currentPassword, newPassword);
        if (statusEl) statusEl.textContent = 'Contraseña actualizada correctamente.';
      } catch (error) {
        if (statusEl) statusEl.textContent = error instanceof Error ? error.message : 'No se pudo restablecer la contraseña.';
      }
    });

    loadProfile();
  </script>
</AppLayout>
