---
import AppLayout from '@/layouts/AppLayout.astro';
---

<AppLayout title="Reseñas">
  <section class="box">
    <h2>Dejar reseña</h2>
    <form id="review-form">
      <label>
        Evento ID
        <input name="eventId" value="event-demo-1" required />
      </label>
      <label>
        Usuario ID
        <input name="userId" value="local-user" required />
      </label>
      <label>
        Calificación
        <select name="rating">
          <option value="5">5 - Excelente</option>
          <option value="4">4 - Muy bueno</option>
          <option value="3">3 - Bueno</option>
          <option value="2">2 - Regular</option>
          <option value="1">1 - Malo</option>
        </select>
      </label>
      <label>
        Comentario
        <textarea name="comment" rows="4" placeholder="Contanos cómo fue tu experiencia..."></textarea>
      </label>
      <button class="btn" type="submit">Publicar reseña</button>
    </form>
    <p id="review-status" aria-live="polite"></p>
  </section>

  <section class="box">
    <h2>Reseñas recientes</h2>
    <div id="review-list"></div>
  </section>

  <script type="module">
    import { api } from '@/lib/api';

    const reviewForm = document.getElementById('review-form');
    const reviewStatus = document.getElementById('review-status');
    const reviewList = document.getElementById('review-list');

    const renderReviews = async () => {
      try {
        const reviews = await api.getReviews('event-demo-1');
        if (!reviews.length) {
          reviewList.innerHTML = '<p>Aún no hay reseñas para este evento.</p>';
          return;
        }

        reviewList.innerHTML = reviews.map((review) => `
          <article class="review-item">
            <strong>${'★'.repeat(Number(review.rating))}${'☆'.repeat(5 - Number(review.rating))}</strong>
            <p>${review.comment || 'Sin comentario.'}</p>
            <small>Usuario: ${review.userId}</small>
          </article>
        `).join('');
      } catch (error) {
        reviewList.innerHTML = '<p>No se pudieron cargar las reseñas.</p>';
      }
    };

    reviewForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(reviewForm);
      const payload = {
        eventId: String(formData.get('eventId') ?? 'event-demo-1'),
        userId: String(formData.get('userId') ?? 'local-user'),
        rating: Number(formData.get('rating') ?? 5),
        comment: String(formData.get('comment') ?? '').trim(),
      };

      try {
        await api.createReview(payload);
        reviewStatus.textContent = 'Reseña guardada correctamente.';
        reviewForm.reset();
        await renderReviews();
      } catch (error) {
        reviewStatus.textContent = error instanceof Error ? error.message : 'No se pudo guardar la reseña.';
      }
    });

    renderReviews();
  </script>
</AppLayout>
