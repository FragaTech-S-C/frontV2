---
import AuthLayout from '@/layouts/AuthLayout.astro';
---

<AuthLayout title="Restablecer contraseña">
  <div class="box" style="border:0;padding:0;background:none;max-width:30rem;margin:0 auto;">
    <h2>Restablecer contraseña</h2>

    <form id="request-reset-form" style="display:flex;flex-direction:column;gap:0.85rem;">
      <label>
        Enviar token al email registrado
        <input type="email" name="email" placeholder="tu@email.com" required />
      </label>
      <button name="sendToken" class="btn" type="submit">Enviar token</button>
    </form>

    <form id="confirm-reset-form" style="display:flex;flex-direction:column;gap:0.85rem;margin-top:1.5rem;">
      <!-- <label>
        Email
        <input type="email" name="email" placeholder="tu@email.com" required />
      </label> -->
      <label>
        Token recibido por email
        <input type="text" name="token" placeholder="Código de verificación" required />
      </label>
      <label>
        Nueva contraseña
        <input type="password" name="newPassword" minlength="8" placeholder="Mínimo 8 caracteres" required />
      </label>
      <label>
        Repetir nueva contraseña
        <input type="password" name="confirmPassword" minlength="8" placeholder="Repetir contraseña" required />
      </label>
      <button class="btn" type="submit">Guardar nueva contraseña</button>
    </form>

    <p id="reset-status" aria-live="polite" style="margin-top:1rem; min-height:1.5rem;"></p>
    <p style="margin-top:1rem;"><a href="/login">Volver al inicio de sesión</a></p>
  </div>

  <script>
    import { api } from '@/lib/api';

    const requestResetForm = document.getElementById('request-reset-form') as HTMLFormElement | null;
    const confirmResetForm = document.getElementById('confirm-reset-form') as HTMLFormElement | null;
    const resetStatus = document.getElementById('reset-status');
    const emailFields = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="email"]'));
    const tokenField = document.querySelector<HTMLInputElement>('input[name="token"]');

    const setStatus = (message: string, isError = false) => {
      if (!resetStatus) return;
      resetStatus.textContent = message;
      resetStatus.style.color = isError ? '#b42318' : '#1d6f42';
    };

    const url = new URL(window.location.href);
    const initialToken = url.searchParams.get('token');
    if (initialToken && tokenField) {
      tokenField.value = initialToken;
    }

    requestResetForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(requestResetForm);
      const email = String(formData.get('email') ?? '').trim();

      if (!email) {
        setStatus('Ingresá tu email registrado.', true);
        return;
      }

      try {
        setStatus('Solicitando token...');
        const data = await api.requestPasswordReset(email);

        const finalEmail = data?.email || email;
        emailFields.forEach((field) => {
          field.value = finalEmail;
        });

        if (tokenField && data?.token) {
          tokenField.value = String(data.token);
        }

        setStatus(`Se envió un token a ${finalEmail}. Copialo y usalo para crear tu nueva contraseña.`);
      } catch (error) {
        setStatus(error instanceof Error ? error.message : 'No se pudo enviar el token.', true);
      }
    });

    confirmResetForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(confirmResetForm);
      const token = String(formData.get('token') ?? '').trim();
      const newPassword = String(formData.get('newPassword') ?? '').trim();
      const confirmPassword = String(formData.get('confirmPassword') ?? '').trim();

      if (!token) {
        setStatus('Ingresá el token recibido por email.', true);
        return;
      }

      if (newPassword.length < 8) {
        setStatus('La contraseña debe tener al menos 8 caracteres.', true);
        return;
      }

      if (newPassword !== confirmPassword) {
        setStatus('Las contraseñas no coinciden.', true);
        return;
      }

      try {
        setStatus('Actualizando contraseña...');
        await api.confirmPasswordReset(token, newPassword);
        setStatus('Contraseña actualizada correctamente.');
        requestResetForm?.reset();
        confirmResetForm?.reset();
        window.setTimeout(() => {
          window.location.href = '/login';
        }, 1200);
      } catch (error) {
        setStatus(error instanceof Error ? error.message : 'No se pudo actualizar la contraseña.', true);
      }
    });
  </script>
</AuthLayout>
