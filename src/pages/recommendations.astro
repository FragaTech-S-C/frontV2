---
import AppLayout from '@/layouts/AppLayout.astro';
---
<AppLayout title="Sugeridos para vos">
  <p class="muted">Eventos recomendados según tus intereses y actividad.</p>

  <div id="rec-status" class="box" style="display:none;"></div>
  <div id="rec-grid" class="grid"></div>
  <p id="rec-empty" class="muted" style="display:none;">Todavía no tenemos recomendaciones personalizadas para vos. Explorá más eventos primero.</p>
</AppLayout>

<script>
  import { api } from '@/lib/api';

  const statusEl = document.getElementById('rec-status');
  const grid = document.getElementById('rec-grid');
  const empty = document.getElementById('rec-empty');

  const show = (msg) => { if (statusEl) { statusEl.style.display = 'block'; statusEl.textContent = msg; } };
  const hide = () => { if (statusEl) statusEl.style.display = 'none'; };

  const formatDate = (v) => {
    if (!v) return 'Sin fecha';
    const d = new Date(v);
    if (isNaN(d)) return 'Sin fecha';
    return new Intl.DateTimeFormat('es-AR', { day:'2-digit', month:'2-digit', year:'numeric' }).format(d);
  };

  const formatLocation = (e) =>
    [e.venueName, e.location, e.city, e.country].filter(Boolean).join(' · ') || 'Sin ubicación';

  const renderEvents = (items) => {
    if (!grid || !empty) return;
    grid.innerHTML = '';

    const events = items.map((item) => item?.event ?? item).filter(Boolean);

    if (!events.length) {
      empty.style.display = 'block';
      return;
    }
    empty.style.display = 'none';

    events.forEach((event) => {
      const card = document.createElement('a');
      card.href = `/events/${event.id}`;
      card.className = 'event-card';
      card.style.textDecoration = 'none';
      const img = event.coverImage || event.bannerImage;
      card.innerHTML = `
        ${img
          ? `<img src="${img}" alt="${event.title ?? 'Evento'}" class="event-card__image" />`
          : `<div class="event-card__image event-card__image--placeholder">Evento</div>`}
        <div class="event-card__content">
          <span class="event-card__tag">${event.category ?? 'Evento'}</span>
          <h3>${event.title ?? 'Sin título'}</h3>
          <p class="event-card__date">${formatDate(event.startDate)}</p>
          <p class="event-card__location">${formatLocation(event)}</p>
        </div>
      `;
      grid.appendChild(card);
    });
  };

  const load = async () => {
    show('Cargando recomendaciones...');
    try {
      const data = await api.getRecommendations(12);
      hide();
      const items = Array.isArray(data) ? data : (data?.events ?? data?.recommendations ?? data?.data ?? []);
      renderEvents(items);
    } catch (e) {
      show(e instanceof Error ? e.message : 'No se pudieron cargar las recomendaciones.');
    }
  };

  load();
</script>

<style>
  .event-card {
    display: block;
    background: #fff;
    border: 1px solid #e6e7ef;
    border-radius: 18px;
    overflow: hidden;
    color: inherit;
    box-shadow: 0 8px 20px rgba(17,24,39,0.05);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .event-card:hover { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(17,24,39,0.08); }
  .event-card__image { display:block;width:100%;height:180px;object-fit:cover;background:#eef2ff; }
  .event-card__image--placeholder { display:grid;place-items:center;font-weight:700;text-transform:uppercase;color:#5b63b7;background:linear-gradient(135deg,#eef2ff,#e0f2fe); }
  .event-card__content { padding:1rem; }
  .event-card__tag { display:inline-block;padding:0.3rem 0.65rem;border-radius:999px;background:#eef2ff;color:#3644c9;font-size:0.72rem;font-weight:700;text-transform:uppercase; }
  .event-card h3 { margin:0.75rem 0 0.4rem;font-size:1.05rem;line-height:1.35;color:#1f2937; }
  .event-card__date,.event-card__location { margin:0.2rem 0;color:#4b5563;font-size:0.9rem; }
</style>
