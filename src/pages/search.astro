---
import AppLayout from '@/layouts/AppLayout.astro';
const apiBase = (import.meta.env.PUBLIC_API_URL ?? import.meta.env.BACKEND_URL ?? 'http://localhost:3000/api').replace(/\/+$/, '');
---
<AppLayout title="Buscar eventos">
  <form id="search-form" class="row">
    <input id="search-input" class="grow" type="search" aria-label="Buscar" placeholder="Buscá eventos, grupos o personas…" />
    <select id="type-filter" style="min-height:44px;border:1.5px solid var(--bd);border-radius:6px;padding:0 10px;font:inherit;">
      <option value="events">Eventos</option>
      <option value="groups">Grupos</option>
      <option value="users">Personas</option>
      <option value="">Todo</option>
    </select>
    <button class="btn" type="submit">Buscar</button>
  </form>

  <div id="search-status" class="box" style="display:none;"></div>
  <div id="search-results" class="grid"></div>
  <p id="search-empty" class="muted" style="display:none;">No se encontraron resultados para tu búsqueda.</p>
</AppLayout>

<script is:inline define:vars={{ apiBase }}>
  const baseUrl = String(apiBase || 'http://localhost:3000/api').replace(/\/+$/, '');
  const getToken = () =>
    localStorage.getItem('meetia-access-token') ??
    localStorage.getItem('accessToken') ??
    localStorage.getItem('access_token') ?? '';

  const form = document.getElementById('search-form');
  const input = document.getElementById('search-input');
  const typeFilter = document.getElementById('type-filter');
  const results = document.getElementById('search-results');
  const statusEl = document.getElementById('search-status');
  const emptyEl = document.getElementById('search-empty');

  const show = (msg) => { if (statusEl) { statusEl.style.display = 'block'; statusEl.textContent = msg; } };
  const hide = () => { if (statusEl) statusEl.style.display = 'none'; };

  const headers = () => ({ Authorization: `Bearer ${getToken()}` });

  const fmtDate = (v) => {
    if (!v) return 'Sin fecha';
    const d = new Date(v);
    if (isNaN(d)) return 'Sin fecha';
    return new Intl.DateTimeFormat('es-AR', { day:'2-digit', month:'2-digit', year:'numeric' }).format(d);
  };

  const renderCard = (item, type) => {
    const e = item?.event ?? item?.group ?? item?.user ?? item;
    if (type === 'groups' || e?.members !== undefined || e?.isPrivate !== undefined) {
      const card = document.createElement('a');
      card.href = `/groups/${e.id}`;
      card.className = 'box';
      card.style.cssText = 'text-decoration:none;color:inherit;';
      card.innerHTML = `
        ${e.avatar ? `<img src="${e.avatar}" alt="${e.name}" style="width:100%;height:140px;object-fit:cover;border-radius:8px;" />` : '<div class="ph">Grupo</div>'}
        <h3>${e.name ?? 'Grupo'}</h3>
        <p>${e.isPrivate ? 'Privado' : 'Público'}</p>
      `;
      return card;
    }
    if (type === 'users' || e?.email !== undefined) {
      const card = document.createElement('div');
      card.className = 'box';
      card.style.cssText = 'display:flex;align-items:center;gap:0.75rem;';
      const name = `${e.firstName ?? ''} ${e.lastName ?? ''}`.trim() || e.email || 'Usuario';
      card.innerHTML = `
        ${e.avatar ? `<img src="${e.avatar}" alt="${name}" style="width:44px;height:44px;border-radius:50%;object-fit:cover;" />` : `<div style="width:44px;height:44px;border-radius:50%;background:#dbeafe;display:grid;place-items:center;font-weight:700;color:#1e40af;">${name[0]?.toUpperCase()??'U'}</div>`}
        <div><strong>${name}</strong><p style="margin:0;font-size:0.85rem;color:#4b5563;">${e.email ?? ''}</p></div>
      `;
      return card;
    }
    // Default: event card
    const card = document.createElement('a');
    card.href = `/events/${e.id}`;
    card.className = 'event-card';
    const img = e.coverImage ?? e.bannerImage;
    card.innerHTML = `
      ${img ? `<img src="${img}" alt="${e.title??'Evento'}" class="event-card__image" />` : '<div class="event-card__image event-card__image--placeholder">Evento</div>'}
      <div class="event-card__content">
        <span class="event-card__tag">${e.category ?? 'Evento'}</span>
        <h3>${e.title ?? 'Sin título'}</h3>
        <p class="event-card__date">${fmtDate(e.startDate ?? e.start_date)}</p>
        <p class="event-card__location">${[e.venueName,e.location,e.city,e.country].filter(Boolean).join(' · ') || 'Sin ubicación'}</p>
      </div>
    `;
    return card;
  };

  const doSearch = async (q, types) => {
    const token = getToken();
    if (!token) { window.location.href = '/login'; return; }
    if (!q || q.length < 2) { show('Ingresá al menos 2 caracteres para buscar.'); return; }

    show('Buscando…');
    if (results) results.innerHTML = '';
    if (emptyEl) emptyEl.style.display = 'none';

    try {
      const params = new URLSearchParams({ q, limit: '12' });
      if (types) params.append('types', types);

      const res = await fetch(`${baseUrl}/search?${params}`, { headers: headers() });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data?.message ?? 'La búsqueda falló.');

      // Backend may return { events, groups, users } or flat array
      const evts = Array.isArray(data) ? data : (data?.events ?? data?.results ?? []);
      const groups = data?.groups ?? [];
      const users = data?.users ?? [];
      const all = [...evts, ...groups, ...users];

      hide();
      if (!all.length) { if (emptyEl) emptyEl.style.display = 'block'; return; }

      all.forEach((item) => {
        const card = renderCard(item, types);
        if (card && results) results.appendChild(card);
      });
    } catch (err) {
      show(err.message ?? 'No se pudo completar la búsqueda.');
    }
  };

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    doSearch(input?.value?.trim() ?? '', typeFilter?.value ?? '');
  });

  // Auto-search on load with empty/broad query for events
  doSearch('e', 'events');
</script>

<style>
  .event-card {
    display:block;background:#fff;border:1px solid #e6e7ef;border-radius:18px;overflow:hidden;
    text-decoration:none;color:inherit;box-shadow:0 8px 20px rgba(17,24,39,0.05);
    transition:transform 0.18s ease,box-shadow 0.18s ease;
  }
  .event-card:hover { transform:translateY(-2px);box-shadow:0 12px 28px rgba(17,24,39,0.08); }
  .event-card__image { display:block;width:100%;height:180px;object-fit:cover;background:#eef2ff; }
  .event-card__image--placeholder { display:grid;place-items:center;font-weight:700;text-transform:uppercase;color:#5b63b7;background:linear-gradient(135deg,#eef2ff,#e0f2fe); }
  .event-card__content { padding:1rem; }
  .event-card__tag { display:inline-block;padding:0.3rem 0.65rem;border-radius:999px;background:#eef2ff;color:#3644c9;font-size:0.72rem;font-weight:700;text-transform:uppercase; }
  .event-card h3 { margin:0.75rem 0 0.4rem;font-size:1.05rem;line-height:1.35;color:#1f2937; }
  .event-card__date,.event-card__location { margin:0.2rem 0;color:#4b5563;font-size:0.9rem; }
</style>
