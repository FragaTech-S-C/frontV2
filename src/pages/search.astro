---
import AppLayout from '@/layouts/AppLayout.astro';
import { api, getApiBaseUrl } from '@/lib/api';
---
<AppLayout title="Discover">
  <form id="search-form" class="row">
    <input id="search-input" class="grow" type="search" aria-label="Buscar" placeholder="Buscar eventos" />
    <button class="btn" type="submit">Buscar</button>
  </form>
  <div class="row">
    <button class="btn out" type="button">Categoría</button><button class="btn out" type="button">Fecha</button><button class="btn out" type="button">Cerca de mí</button>
  </div>
  <div id="search-status" class="box" style="margin-bottom:1rem;display:none"></div>
  <div id="search-results" class="grid"></div>

  <script is:inline define:vars={{ apiBase: (import.meta.env.PUBLIC_API_URL ?? import.meta.env.BACKEND_URL ?? 'http://localhost:3000/api').replace(/\/+$/, '') }}>
    const baseApiUrl = String(apiBase || 'http://localhost:3000/api').replace(/\/+$/, '');
    const status = document.getElementById('search-status');
    const form = document.getElementById('search-form');
    const input = document.getElementById('search-input');
    const results = document.getElementById('search-results');
    const token =
      localStorage.getItem('meetia-access-token') ??
      localStorage.getItem('accessToken') ??
      localStorage.getItem('access_token') ??
      '';

    const formatArgentinaDate = (value) => {
      if (!value) return 'Sin fecha';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return 'Sin fecha';
      const day = String(date.getDate()).padStart(2, '0');
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const year = date.getFullYear();
      return `${day}-${month}-${year}`;
    };

    const formatLocation = (event) => {
      const parts = [event.location, event.city, event.country, event.address].filter(Boolean);
      return parts.length ? parts.join(' - ') : 'Sin ubicación';
    };

    // El backend devuelve { type, id, title, metadata: {...} }.
    // Aplanamos metadata para tener coverImage, startDate, location, etc. al nivel del evento.
    const normalizeEvent = (entry) => {
      const base = entry?.event ?? entry ?? {};
      const event = { ...base, ...(base.metadata ?? {}) };
      return {
        ...event,
        id: event.id ?? event._id,
        title: event.title ?? event.name ?? 'Evento sin título',
        startDate: event.startDate ?? event.start_date ?? event.date ?? null,
        coverImage: event.coverImage ?? event.cover_image ?? event.bannerImage ?? event.banner_image ?? null,
        bannerImage: event.bannerImage ?? event.banner_image ?? event.coverImage ?? event.cover_image ?? null,
      };
    };

    const renderResults = (items) => {
      if (!results) return;
      results.innerHTML = '';

      const mapped = (items || [])
        .filter((entry) => !entry.type || entry.type === 'event')
        .map(normalizeEvent);

      if (mapped.length === 0) {
        status.style.display = 'block';
        status.textContent = 'No se encontraron resultados.';
        return;
      }

      mapped.forEach((event) => {
        const card = document.createElement('a');
        card.href = `/events/${event.id}`;
        card.className = 'box';
        card.style.textDecoration = 'none';
        card.style.color = 'inherit';
        const imageUrl = event.coverImage || event.bannerImage;
        card.innerHTML = `
          ${imageUrl ? `<img src="${imageUrl}" alt="${event.title || 'Evento'}" style="width:100%;height:180px;object-fit:cover;border-radius:12px;display:block;" />` : '<div class="ph">Evento</div>'}
          <h3>${event.title || 'Evento sin título'}</h3>
          <p>${formatArgentinaDate(event.startDate)} · ${formatLocation(event)}</p>
        `;
        results.appendChild(card);
      });
    };

    const loadSearch = async (query) => {
      if (!token) {
        window.location.href = '/login';
        return;
      }

      status.style.display = 'block';
      status.textContent = 'Buscando eventos...';

      try {
        const params = new URLSearchParams({ types: 'event', limit: '24' });
        if (query) params.set('q', query);
        const url = `${baseApiUrl}/search?${params}&types=event`;
        const response = await fetch(url, {
          headers: { Authorization: `Bearer ${token}` },
        });
        const payload = await response.json().catch(() => []);

        if (!response.ok) {
          throw new Error(payload.message || 'La búsqueda falló.');
        }

        // Ocultar antes de renderizar, así no tapa el mensaje de "sin resultados".
        status.style.display = 'none';
        renderResults(Array.isArray(payload) ? payload : payload.events || []);
      } catch (error) {
        status.style.display = 'block';
        status.textContent = error.message || 'No se pudo completar la búsqueda.';
      }
    };

    if (!baseApiUrl) {
      status.style.display = 'block';
      status.textContent = 'La API no está configurada. Agregá PUBLIC_API_URL o BACKEND_URL en tu entorno.';
    } else {
      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        loadSearch(input.value.trim());
      });
      loadSearch('');
    }
  </script>
</AppLayout>
