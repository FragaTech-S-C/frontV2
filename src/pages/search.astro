---
import AppLayout from '@/layouts/AppLayout.astro';
import { api, getApiBaseUrl } from '@/lib/api';
---
<AppLayout title="Buscar eventos">
  <form id="search-form" class="row">
    <input id="search-input" class="grow" type="search" aria-label="Buscar" placeholder="Metabuscador de eventos" />
    <button class="btn" type="submit">Buscar</button>
  </form>
  <div class="row">
    <button class="btn out" type="button">Categoría</button><button class="btn out" type="button">Fecha</button><button class="btn out" type="button">Cerca de mí</button>
  </div>
  <div id="search-status" class="box" style="margin-bottom:1rem;display:none"></div>
  <div id="search-results" class="grid"></div>

  <script is:inline define:vars={{ apiBase: (import.meta.env.PUBLIC_API_URL ?? import.meta.env.BACKEND_URL ?? 'http://localhost:3000/api').replace(/\/+$/, '') }}>
    const baseApiUrl = String(apiBase || 'http://localhost:3000/api').replace(/\/+$/, '');
    const status = document.getElementById('search-status');

    if (!baseApiUrl) {
      if (status) {
        status.style.display = 'block';
        status.textContent = 'La API no está configurada. Agregá PUBLIC_API_URL o BACKEND_URL en tu entorno.';
      }
    } else {
      const token = localStorage.getItem('meetia-access-token');
      const form = document.getElementById('search-form');
      const input = document.getElementById('search-input');
      const results = document.getElementById('search-results');

    const formatArgentinaDate = (value) => {
      if (!value) return 'Sin fecha';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return 'Sin fecha';
      const day = String(date.getDate()).padStart(2, '0');
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const year = date.getFullYear();
      return `${day}-${month}-${year}`;
    };

    const formatLocation = (event) => {
      const parts = [event.location, event.city, event.country, event.address].filter(Boolean);
      return parts.length ? parts.join(' - ') : 'Sin ubicación';
    };

    const normalizeSearchItem = (entry) => {
      const item = entry?.event ?? entry ?? {};
      const metadata = item.metadata ?? {};

      return {
        id: item.id ?? metadata.id,
        title: item.title ?? metadata.title ?? 'Evento sin título',
        category: metadata.category ?? 'Evento',
        startDate: metadata.startDate ?? item.startDate ?? item.date ?? null,
        endDate: metadata.endDate ?? null,
        location: metadata.location ?? item.location ?? null,
        city: metadata.city ?? item.city ?? null,
        country: metadata.country ?? item.country ?? null,
        address: metadata.address ?? item.address ?? null,
        coverImage: metadata.coverImage ?? item.coverImage ?? metadata.bannerImage ?? item.bannerImage ?? null,
        bannerImage: metadata.bannerImage ?? item.bannerImage ?? metadata.coverImage ?? item.coverImage ?? null,
      };
    };

    const renderResults = (items) => {
      if (!results) return;
      results.innerHTML = '';

      const list = Array.isArray(items) ? items : [];
      if (!list.length) {
        status.style.display = 'block';
        status.textContent = 'No se encontraron resultados.';
        return;
      }

      const mapped = list
        .filter((entry) => entry && (entry.type === 'event' || entry.event || entry.metadata || entry.id))
        .map(normalizeSearchItem)
        .filter((event) => event && event.id);

      if (!mapped.length) {
        status.style.display = 'block';
        status.textContent = 'No se encontraron resultados.';
        return;
      }

      mapped.forEach((event) => {
        const card = document.createElement('a');
        card.href = `/events/${event.id}`;
        card.className = 'box';
        card.style.textDecoration = 'none';
        card.style.color = 'inherit';
        const imageUrl = event.coverImage || event.bannerImage;
        card.innerHTML = `
          ${imageUrl ? `<img src="${imageUrl}" alt="${event.title || 'Evento'}" style="width:100%;height:180px;object-fit:cover;border-radius:12px;display:block;" />` : '<div class="ph">Evento</div>'}
          <h3>${event.title || 'Evento sin título'}</h3>
          <p>${formatArgentinaDate(event.startDate)} · ${formatLocation(event)}</p>
        `;
        results.appendChild(card);
      });
    };

    const loadSearch = async (query) => {
      if (!token) {
        window.location.href = '/login';
        return;
      }

      status.style.display = 'block';
      status.textContent = 'Buscando eventos...';

      try {
        const url = `${baseApiUrl}/search?types=event&q=${encodeURIComponent(query || 'evento')}&limit=6`;
        const response = await fetch(url, {
          headers: { Authorization: `Bearer ${token}` },
        });
        const payload = await response.json().catch(() => []);

        if (!response.ok) {
          throw new Error(payload.message || 'La búsqueda falló.');
        }

        renderResults(Array.isArray(payload) ? payload : payload.events || []);
        status.style.display = 'none';
      } catch (error) {
        status.style.display = 'block';
        status.textContent = error.message || 'No se pudo completar la búsqueda.';
      }
    };

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      loadSearch(input.value.trim());
    });

    loadSearch('evento');
    }
  </script>
</AppLayout>
