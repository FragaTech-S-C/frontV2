---
import AppLayout from '@/layouts/AppLayout.astro';
export function getStaticPaths() { return [{ params: { id: '1' } }]; }
---
<AppLayout title="Cómo llegar">
  <div class="grid" style="grid-template-columns:2fr 1fr">
    <div class="ph" style="min-height:360px">Mapa con ruta optimizada</div>
    <aside class="box">
      <h3>Medio de transporte</h3>
      <button class="btn out">A pie</button>
      <button class="btn out">Transporte público</button>
      <button class="btn out">Auto</button>
      <p>Tiempo y distancia estimados.</p>
    </aside>
  </div>
</AppLayout>
