---
import AppLayout from '@/layouts/AppLayout.astro';
---

<AppLayout title="Editar evento">
  <form id="event-edit-form" class="box">
    <label>
      Título
      <input name="title" value="Meetup de comunidad" required />
    </label>
    <label>
      Descripción
      <textarea name="description" rows="4">Evento de prueba para la edición de datos.</textarea>
    </label>
    <label>
      Ubicación
      <input name="location" value="CABA" required />
    </label>
    <label>
      Fecha de inicio
      <input name="startDate" type="datetime-local" value="2026-11-12T19:00" />
    </label>
    <button class="btn" type="submit">Guardar cambios</button>
    <p id="event-edit-status" aria-live="polite"></p>
  </form>

  <script type="module">
    import { api } from '@/lib/api';

    const form = document.getElementById('event-edit-form');
    const status = document.getElementById('event-edit-status');
    const eventId = window.location.pathname.split('/').filter(Boolean)[1];

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(form);

      try {
        await api.createEvent({
          title: String(formData.get('title') ?? ''),
          description: String(formData.get('description') ?? ''),
          location: String(formData.get('location') ?? ''),
          startDate: String(formData.get('startDate') ?? new Date().toISOString()),
          eventId,
        });
        status.textContent = 'Evento actualizado correctamente.';
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : 'No se pudo actualizar el evento.';
      }
    });
  </script>
</AppLayout>
