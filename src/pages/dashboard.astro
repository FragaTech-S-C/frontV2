---
import AppLayout from '@/layouts/AppLayout.astro';

const apiBase = (import.meta.env.PUBLIC_API_URL ?? import.meta.env.BACKEND_URL ?? 'http://localhost:3000/api').replace(/\/+$/, '');
---
<AppLayout title="Dashboard">
  <div class="row">
    <input id="dash-search" class="grow" type="search" aria-label="Buscar eventos" placeholder="Buscar eventos…" />
    <button id="dash-search-btn" class="btn" type="button">Buscar</button>
    <a class="btn" href="/events/new">+ Nuevo evento</a>
  </div>

  <!-- Quick stats -->
  <div class="grid" id="stats-grid" style="grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:1rem;"></div>

  <div id="dash-status" class="box" style="display:none;"></div>

  <!-- Tabs -->
  <div class="row" style="gap:0.5rem;flex-wrap:wrap;">
    <button class="tab-btn btn active-tab" data-tab="upcoming" type="button">Próximos</button>
    <button class="tab-btn btn out" data-tab="mine" type="button">Mis eventos</button>
    <button class="tab-btn btn out" data-tab="recommended" type="button">Recomendados</button>
  </div>

  <div id="dash-grid" class="grid"></div>
</AppLayout>

<script is:inline define:vars={{ apiBase }}>
  const baseUrl = String(apiBase || 'http://localhost:3000/api').replace(/\/+$/, '');
  const getToken = () =>
    localStorage.getItem('meetia-access-token') ??
    localStorage.getItem('accessToken') ??
    localStorage.getItem('access_token') ?? '';

  const statusEl = document.getElementById('dash-status');
  const grid = document.getElementById('dash-grid');
  const statsGrid = document.getElementById('stats-grid');
  const searchInput = document.getElementById('dash-search');
  const searchBtn = document.getElementById('dash-search-btn');

  let activeTab = 'upcoming';

  // ── Helpers ──────────────────────────────────────────────────────────────────

  const show = (msg) => { if (statusEl) { statusEl.style.display = 'block'; statusEl.textContent = msg; } };
  const hide = () => { if (statusEl) statusEl.style.display = 'none'; };

  const headers = () => ({ Authorization: `Bearer ${getToken()}` });

  const fmtDate = (v) => {
    if (!v) return 'Sin fecha';
    const d = new Date(v);
    if (isNaN(d)) return 'Sin fecha';
    return new Intl.DateTimeFormat('es-AR', { day:'2-digit', month:'2-digit', year:'numeric' }).format(d);
  };

  const fmtLoc = (e) =>
    [e.venueName, e.location, e.city, e.country].filter(Boolean).join(' · ') || 'Sin ubicación';

  const normalize = (raw) => {
    const e = raw?.event ?? raw ?? {};
    return {
      ...e,
      id: e.id ?? e._id,
      title: e.title ?? e.name ?? 'Sin título',
      category: e.category ?? 'Evento',
      startDate: e.startDate ?? e.start_date ?? null,
      coverImage: e.coverImage ?? e.cover_image ?? e.bannerImage ?? null,
    };
  };

  const normalizeList = (payload) => {
    const arr = Array.isArray(payload) ? payload : (payload?.events ?? payload?.data ?? []);
    return arr.map(normalize).filter(Boolean);
  };

  // ── Render ───────────────────────────────────────────────────────────────────

  const renderEvents = (events) => {
    if (!grid) return;
    grid.innerHTML = '';
    if (!events.length) {
      show('No hay eventos para mostrar.');
      return;
    }
    hide();
    events.forEach((ev) => {
      const card = document.createElement('a');
      card.href = `/events/${ev.id}`;
      card.className = 'event-card';
      const img = ev.coverImage;
      card.innerHTML = `
        ${img
          ? `<img src="${img}" alt="${ev.title}" class="event-card__image" />`
          : `<div class="event-card__image event-card__image--placeholder">${ev.category}</div>`}
        <div class="event-card__content">
          <span class="event-card__tag">${ev.category}</span>
          <h3>${ev.title}</h3>
          <p class="event-card__date">${fmtDate(ev.startDate)}</p>
          <p class="event-card__location">${fmtLoc(ev)}</p>
        </div>
      `;
      grid.appendChild(card);
    });
  };

  // ── Stats ────────────────────────────────────────────────────────────────────

  const renderStats = (items) => {
    if (!statsGrid) return;
    const total = items.length;
    const categories = new Set(items.map((e) => e.category).filter(Boolean)).size;
    const upcoming = items.filter((e) => e.startDate && new Date(e.startDate) > new Date()).length;

    statsGrid.innerHTML = [
      { label: 'Eventos cargados', value: total },
      { label: 'Próximos', value: upcoming },
      { label: 'Categorías', value: categories },
    ].map(({ label, value }) => `
      <div class="box" style="text-align:center;padding:1.25rem;">
        <strong style="font-size:1.8rem;color:#2f5d8a;">${value}</strong>
        <p style="margin:0.4rem 0 0;font-size:0.82rem;color:#4b5563;">${label}</p>
      </div>
    `).join('');
  };

  // ── Fetch ────────────────────────────────────────────────────────────────────

  const fetchData = async (url) => {
    const res = await fetch(url, { headers: headers() });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data?.message ?? data?.error ?? 'Error al cargar datos.');
    return data;
  };

  const loadTab = async (tab, query = '') => {
    const token = getToken();
    if (!token) { window.location.href = '/login'; return; }

    show('Cargando…');

    let url;
    if (query) {
      url = `${baseUrl}/search?q=${encodeURIComponent(query)}&types=events&limit=12`;
    } else if (tab === 'upcoming') {
      url = `${baseUrl}/events/upcoming?limit=12`;
    } else if (tab === 'mine') {
      url = `${baseUrl}/events/find?limit=12`;
    } else {
      url = `${baseUrl}/recommendations?limit=12`;
    }

    try {
      const payload = await fetchData(url);
      const events = normalizeList(payload);
      renderStats(events);
      renderEvents(events);
    } catch (err) {
      show(err.message ?? 'No se pudieron cargar los eventos.');
    }
  };

  // ── Tabs ─────────────────────────────────────────────────────────────────────

  document.querySelectorAll('.tab-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach((b) => {
        b.classList.remove('active-tab');
        b.classList.add('out');
      });
      btn.classList.add('active-tab');
      btn.classList.remove('out');
      activeTab = btn.dataset.tab;
      loadTab(activeTab);
    });
  });

  searchBtn?.addEventListener('click', () => loadTab(activeTab, searchInput?.value?.trim() ?? ''));
  searchInput?.addEventListener('keydown', (e) => { if (e.key === 'Enter') loadTab(activeTab, searchInput.value.trim()); });

  loadTab('upcoming');
</script>

<style>
  .active-tab { background:var(--acc) !important; color:#fff !important; border-color:var(--acc) !important; }
  .event-card {
    display:block;background:#fff;border:1px solid #e6e7ef;border-radius:18px;overflow:hidden;
    text-decoration:none;color:inherit;box-shadow:0 8px 20px rgba(17,24,39,0.05);
    transition:transform 0.18s ease,box-shadow 0.18s ease;
  }
  .event-card:hover { transform:translateY(-2px);box-shadow:0 12px 28px rgba(17,24,39,0.08); }
  .event-card__image { display:block;width:100%;height:180px;object-fit:cover;background:#eef2ff; }
  .event-card__image--placeholder { display:grid;place-items:center;font-weight:700;text-transform:uppercase;color:#5b63b7;background:linear-gradient(135deg,#eef2ff,#e0f2fe); }
  .event-card__content { padding:1rem; }
  .event-card__tag { display:inline-block;padding:0.3rem 0.65rem;border-radius:999px;background:#eef2ff;color:#3644c9;font-size:0.72rem;font-weight:700;text-transform:uppercase; }
  .event-card h3 { margin:0.75rem 0 0.4rem;font-size:1.05rem;line-height:1.35;color:#1f2937; }
  .event-card__date,.event-card__location { margin:0.2rem 0;color:#4b5563;font-size:0.9rem; }
</style>
