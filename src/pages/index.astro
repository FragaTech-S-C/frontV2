---
import AppLayout from '@/layouts/AppLayout.astro';
---

<AppLayout title="Home">
  <section class="hero box">
    <div class="hero-copy">
      <p class="eyebrow">Meetia</p>
      <h2>Descubrí eventos, grupos y oportunidades cerca de vos.</h2>
      <p class="lead">Encontrá conferencias, workshops, reuniones y actividades para tu comunidad, universidad o grupo.</p>

      <div class="row" style="margin-top:1rem;">
        <a href="/dashboard" class="btn">Ir al dashboard</a>
        <a href="/search" class="btn out">Explorar eventos</a>
      </div>
    </div>

    <div class="hero-panel">
      <div class="mini-card primary">
        <span>Eventos</span>
        <strong>240+</strong>
      </div>
      <div class="mini-card">
        <span>Grupos</span>
        <strong>32</strong>
      </div>
      <div class="mini-card accent">
        <span>Hoy</span>
        <strong>9</strong>
      </div>
    </div>
  </section>

  <div class="grid">
    <article class="box feature">
      <h3>Buscar rápido</h3>
      <p>Encontrá eventos por categoría, ubicación, interés o fecha sin perder tiempo.</p>
    </article>

    <article class="box feature">
      <h3>Crear tus propios eventos</h3>
      <p>Publicá actividades, reuniones o talleres y gestioná participantes con facilidad.</p>
    </article>

    <article class="box feature">
      <h3>Conectar comunidad</h3>
      <p>Sumate a grupos, invitaciones y recomendaciones hechas para tu perfil.</p>
    </article>
  </div>

  <section class="box">
    <h3>¿Qué podés hacer en Meetia?</h3>
    <div class="check-list">
      <div>✔ Explorar eventos recomendados para vos</div>
      <div>✔ Guardar o seguir actividades que te interesen</div>
      <div>✔ Crear eventos públicos o institucionales</div>
      <div>✔ Participar de grupos y comunidades</div>
    </div>
  </section>
</AppLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 1.5rem;
    align-items: center;
    padding: 2rem;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: #2f5d8a;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-copy h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  .lead {
    font-size: 1.05rem;
    line-height: 1.6;
    color: #4b5563;
    max-width: 52ch;
  }

  .hero-panel {
    display: grid;
    gap: 1rem;
  }

  .mini-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #eef4ff;
    border: 1px solid #d8e3f7;
    border-radius: 16px;
    padding: 1rem 1.1rem;
    color: #1f2937;
  }

  .mini-card.primary {
    background: linear-gradient(135deg, #eef5ff, #ddeaff);
  }

  .mini-card.accent {
    background: linear-gradient(135deg, #ecfdf5, #d9f9ed);
  }

  .mini-card span {
    font-size: 0.8rem;
    font-weight: 600;
    color: #475569;
  }

  .mini-card strong {
    font-size: 1.5rem;
  }

  .feature h3 {
    margin-bottom: 0.5rem;
  }

  .check-list {
    display: grid;
    gap: 0.8rem;
    margin-top: 1rem;
    color: #374151;
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }
</style>