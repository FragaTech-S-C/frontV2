---
import Base from './Base.astro';
const { title } = Astro.props;
const path = Astro.url.pathname;

const links: [string, string][] = [
  ['/', 'Home'],
  ['/dashboard', 'Dashboard'],
  ['/search', 'Buscar'],
  ['/groups', 'Grupos'],
  ['/recommendations', 'Sugeridos'],
  ['/invitations', 'Invitaciones'],
  ['/profile', 'Perfil'],
];
---
<Base title={title}>
  <div class="app">
    <nav class="nav" aria-label="Principal">
      <a class="brand" href="/">Meetia</a>
      {links.map(([href, label]) => (
        <a href={href} aria-current={path === href || (href !== '/' && path.startsWith(href)) ? 'page' : undefined}>
          {label}
        </a>
      ))}
      <span class="grow"></span>
      <button id="logout-button" type="button" class="btn out" style="display:none;">Cerrar sesión</button>
    </nav>
    <main class="main">
      <h1>{title}</h1>
      <slot />
    </main>
  </div>

  <script>
    import { api, clearStoredAuth, getAccessToken } from '@/lib/api';

    // Redirect to login if not authenticated (client-side guard)
    if (typeof window !== 'undefined') {
      const token = getAccessToken();
      const publicPaths = ['/login', '/register', '/'];
      const isPublic = publicPaths.some((p) => window.location.pathname === p);
      if (!token && !isPublic) {
        window.location.href = '/login';
      }
      // Show logout button only if logged in
      const logoutButton = document.getElementById('logout-button');
      if (logoutButton && token) {
        logoutButton.style.display = 'inline-flex';
      }
    }

    const logoutButton = document.getElementById('logout-button');
    logoutButton?.addEventListener('click', async () => {
      try {
        await api.logout();
      } catch {
        // ignore — clear anyway
      } finally {
        clearStoredAuth();
        window.location.href = '/login';
      }
    });
  </script>
</Base>
