---
import Base from './Base.astro';
const { title } = Astro.props;
const path = Astro.url.pathname;
const links = [
  ['/', 'Home'], ['/groups', 'Grupos'],

  ['/dashboard', 'Dashboard'], ['/search', 'Buscar'],
  ['/invitations', 'Invitaciones'], ['/profile', 'Perfil'],
];
---
<Base title={title}>
  <div class="app">
    <nav class="nav" aria-label="Principal">
        <span class="brand">Meetia</span>
      {links.map(([href, label]) => (
        <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>
      ))}
      <button id="logout-button" type="button" class="btn out">Cerrar sesión</button>
    </nav>
    <main class="main">
      <h1>{title}</h1>
      <slot />
    </main>
  </div>

  <script>
    import { api, clearStoredAuth } from '@/lib/api';

    const logoutButton = document.getElementById('logout-button');

    logoutButton?.addEventListener('click', async () => {
      try {
        await api.logout();
      } catch (error) {
        console.warn('Logout request failed:', error);
      } finally {
        clearStoredAuth();
        window.location.href = '/login';
      }
    });
  </script>
</Base>
