---
const { cancelHref = '/dashboard', eventId = '' } = Astro.props;

const categoryOptions = [
  { value: 'CONFERENCE', label: 'Conferencia' },
  { value: 'WORKSHOP', label: 'Taller' },
  { value: 'MEETING', label: 'Reunión' },
  { value: 'SOCIAL', label: 'Social' },
  { value: 'SPORTS', label: 'Deportivo' },
  { value: 'CULTURAL', label: 'Cultural' },
  { value: 'EDUCATIONAL', label: 'Educativo' },
  { value: 'NETWORKING', label: 'Networking' },
  { value: 'OTHER', label: 'Otros' },
] as const;

const visibilityOptions = [
  { value: 'PUBLIC', label: 'Público' },
  { value: 'INSTITUTION', label: 'Institución' },
  { value: 'GROUP', label: 'Grupo' },
  { value: 'PRIVATE', label: 'Privado' },
] as const;

const provinceOptions = [
  'CABA','Buenos Aires','Catamarca','Chaco','Chubut','Córdoba','Corrientes',
  'Entre Ríos','Formosa','Jujuy','La Pampa','La Rioja','Mendoza','Misiones',
  'Neuquén','Río Negro','Salta','San Juan','San Luis','Santa Cruz','Santa Fe',
  'Santiago del Estero','Tierra del Fuego','Tucumán',
] as const;
---
<form id="event-form" class="box">
  <label>Título <span style="color:#b91c1c">*</span><input name="title" required /></label>
  <label>Descripción<textarea name="description" rows="4"></textarea></label>
  <label>Descripción corta<input name="shortDescription" placeholder="Resumen breve (opcional)" /></label>

  <div class="row">
    <label class="grow">Inicio <span style="color:#b91c1c">*</span><input type="datetime-local" name="startDate" required /></label>
    <label class="grow">Fin<input type="datetime-local" name="endDate" /></label>
  </div>

  <div class="row">
    <label class="grow">Categoría
      <select name="category">
        {categoryOptions.map(({ value, label }) => (
          <option value={value}>{label}</option>
        ))}
      </select>
    </label>
    <label class="grow">Visibilidad
      <select name="visibility">
        {visibilityOptions.map(({ value, label }) => (
          <option value={value}>{label}</option>
        ))}
      </select>
    </label>
  </div>

  <!-- Location fields -->
  <div class="row">
    <label class="grow">Nombre del venue<input name="venueName" placeholder="Club, sala, etc." /></label>
    <label class="grow">Dirección<input name="location" placeholder="Av. Corrientes 1234" /></label>
  </div>
  <div class="row">
    <label class="grow">Ciudad<input name="city" placeholder="Buenos Aires" /></label>
    <label class="grow">Provincia
      <select name="province">
        <option value="">Seleccioná</option>
        {provinceOptions.map((p) => (
          <option value={p}>{p}</option>
        ))}
      </select>
    </label>
  </div>

  <!-- Extra fields shown when visibility = INSTITUTION -->
  <div id="institutional-event-fields" style="display:none;">
    <div class="row">
      <label class="grow">Institución asociada
        <select name="institutionId" id="institution-select">
          <option value="">Cargando…</option>
        </select>
      </label>
      <label class="grow">Máx. asistentes<input type="number" name="maxAttendees" min="0" value="0" /></label>
    </div>
    <div class="row">
      <label class="grow">Etiquetas (separadas por coma)<input name="tags" placeholder="tech, networking" /></label>
    </div>
    <label>Página web<input type="url" name="website" /></label>
    <label>URL de inscripción<input type="url" name="registrationUrl" /></label>
  </div>

  <div class="row">
    <label class="grow">¿Es gratis?
      <select name="isFree">
        <option value="true">Sí</option>
        <option value="false">No</option>
      </select>
    </label>
    <label class="grow" id="price-field-wrapper" style="display:none;">
      Precio
      <input type="number" name="price" min="0" step="0.01" placeholder="0.00" />
    </label>
  </div>

  <label>URL de imagen de portada<input type="url" name="coverImage" placeholder="https://example.com/cover.jpg" /></label>

  <div id="event-status" class="muted" aria-live="polite" style="display:none;"></div>
  <div class="row">
    <button class="btn" type="submit">Guardar evento</button>
    <a class="btn out" href={cancelHref}>Cancelar</a>
  </div>
</form>

<script>
  import { api, getAccessToken } from '@/lib/api';

  const form = document.getElementById('event-form') as HTMLFormElement | null;
  const statusBox = document.getElementById('event-status');
  const visibilityField = form?.querySelector('select[name="visibility"]') as HTMLSelectElement | null;
  const institutionalFields = document.getElementById('institutional-event-fields');
  const priceFieldWrapper = document.getElementById('price-field-wrapper');
  const isFreeField = form?.querySelector('select[name="isFree"]') as HTMLSelectElement | null;
  const institutionSelect = document.getElementById('institution-select') as HTMLSelectElement | null;
  const startDateField = form?.querySelector('input[name="startDate"]') as HTMLInputElement | null;
  const endDateField = form?.querySelector('input[name="endDate"]') as HTMLInputElement | null;

  // Set minimum date to now
  const now = new Date();
  now.setSeconds(0, 0);
  const minDT = now.toISOString().slice(0, 16);
  if (startDateField) startDateField.min = minDT;
  if (endDateField) endDateField.min = minDT;

  const showStatus = (msg: string) => {
    if (statusBox) { statusBox.style.display = 'block'; statusBox.textContent = msg; }
  };

  const updateInstitutionalVisibility = () => {
    const isInst = visibilityField?.value === 'INSTITUTION';
    if (institutionalFields) institutionalFields.style.display = isInst ? 'block' : 'none';
  };

  const updatePriceVisibility = () => {
    if (!priceFieldWrapper || !isFreeField) return;
    const isFree = isFreeField.value === 'true';
    priceFieldWrapper.style.display = isFree ? 'none' : 'flex';
    const priceInput = priceFieldWrapper.querySelector('input') as HTMLInputElement | null;
    if (priceInput) { priceInput.disabled = isFree; priceInput.required = !isFree; }
  };

  // Load institutions
  const loadInstitutions = async () => {
    if (!institutionSelect) return;
    try {
      const data = await api.getInstitutions() as unknown;
      const items = Array.isArray(data) ? data : ((data as any)?.institutions ?? (data as any)?.data ?? []);
      institutionSelect.innerHTML = '<option value="">Seleccioná una institución</option>';
      items.forEach((inst: any) => {
        const opt = document.createElement('option');
        opt.value = inst.id;
        opt.textContent = inst.name;
        institutionSelect.appendChild(opt);
      });
    } catch {
      institutionSelect.innerHTML = '<option value="">No se pudieron cargar</option>';
    }
  };

  visibilityField?.addEventListener('change', updateInstitutionalVisibility);
  isFreeField?.addEventListener('change', updatePriceVisibility);
  updateInstitutionalVisibility();
  updatePriceVisibility();
  loadInstitutions();

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const token = getAccessToken();
    if (!token) {
      showStatus('Tu sesión expiró. Iniciá sesión nuevamente.');
      window.location.href = '/login';
      return;
    }

    const fd = new FormData(form);
    const visibility = String(fd.get('visibility') ?? 'PUBLIC');
    const startRaw = fd.get('startDate');
    const endRaw = fd.get('endDate');
    const startDate = startRaw ? new Date(String(startRaw)) : null;
    const endDate = endRaw ? new Date(String(endRaw)) : null;
    const isFree = String(fd.get('isFree') ?? 'true') === 'true';
    const institutionId = String(fd.get('institutionId') ?? '').trim();
    const province = String(fd.get('province') ?? '').trim();
    const city = String(fd.get('city') ?? '').trim();
    const location = String(fd.get('location') ?? '').trim();
    const provinceLabel = province === 'CABA' ? 'CABA' : province ? `Prov. ${province}` : '';
    const fullLocation = [location, city, provinceLabel].filter(Boolean).join(' - ');

    if (visibility === 'INSTITUTION' && !institutionId) {
      showStatus('Seleccioná la institución para este evento institucional.');
      return;
    }

    if (startDate && startDate < new Date()) {
      showStatus('La fecha de inicio no puede ser anterior a hoy.');
      return;
    }

    if (endDate && startDate && endDate < startDate) {
      showStatus('La fecha de fin debe ser igual o posterior a la de inicio.');
      return;
    }

    const title = String(fd.get('title') ?? '').trim();
    if (!title || !startDate) {
      showStatus('Completá el título y la fecha de inicio.');
      return;
    }

    const payload: Record<string, unknown> = {
      title,
      description: String(fd.get('description') ?? '').trim() || undefined,
      shortDescription: String(fd.get('shortDescription') ?? '').trim() || undefined,
      category: fd.get('category') ?? 'OTHER',
      visibility,
      institutionId: visibility === 'INSTITUTION' ? (institutionId || undefined) : undefined,
      startDate: startDate.toISOString(),
      endDate: endDate ? endDate.toISOString() : startDate.toISOString(),
      venueName: String(fd.get('venueName') ?? '').trim() || undefined,
      location: fullLocation || undefined,
      city: city || undefined,
      country: 'Argentina',
      tags: String(fd.get('tags') ?? '').split(',').map((t: string) => t.trim()).filter(Boolean),
      maxAttendees: Number(fd.get('maxAttendees') ?? 0),
      isFree,
      price: isFree ? undefined : (Number(fd.get('price')) || undefined),
      website: String(fd.get('website') ?? '').trim() || undefined,
      registrationUrl: String(fd.get('registrationUrl') ?? '').trim() || undefined,
      coverImage: String(fd.get('coverImage') ?? '').trim() || undefined,
      status: 'PUBLISHED',
    };

    showStatus('Guardando evento…');

    try {
      const result = await api.createEvent(payload) as any;
      const id = result?.id ?? result?.event?.id;
      window.location.href = id ? `/events/${id}` : '/dashboard';
    } catch (err) {
      showStatus(err instanceof Error ? err.message : 'No se pudo guardar el evento.');
    }
  });
</script>
