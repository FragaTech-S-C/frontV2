---
const { cancelHref = '/dashboard' } = Astro.props;

type EventCategory =
  | 'CONFERENCE'
  | 'WORKSHOP'
  | 'MEETING'
  | 'SOCIAL'
  | 'SPORTS'
  | 'CULTURAL'
  | 'EDUCATIONAL'
  | 'NETWORKING'
  | 'OTHER';

type EventVisibility = 'PUBLIC' | 'INSTITUTION' | 'GROUP' | 'PRIVATE';

type form = {
  category: EventCategory;
  visibility: EventVisibility;
  ubication: string;
  province: string;
  inst?: number;
  maxAttendees?: number;
  tags?: Array<string>;
  isFree?: boolean;
  website?: string;
  registrationUrl?: string;
  coverImage?: string;
};

const categoryOptions = [
  { value: 'CONFERENCE', label: 'Conferencia' },
  { value: 'WORKSHOP', label: 'Taller' },
  { value: 'MEETING', label: 'Reunión' },
  { value: 'SOCIAL', label: 'Social' },
  { value: 'SPORTS', label: 'Deportivo' },
  { value: 'CULTURAL', label: 'Cultural' },
  { value: 'EDUCATIONAL', label: 'Educativo' },
  { value: 'NETWORKING', label: 'Networking' },
  { value: 'OTHER', label: 'Otros' },
] as const;

const visibilityOptions = [
  { value: 'PUBLIC', label: 'Público' },
  { value: 'INSTITUTION', label: 'Institución' },
  { value: 'GROUP', label: 'Grupo' },
  { value: 'PRIVATE', label: 'Privado' },
] as const;

const provinceOptions = [
  'CABA',
  'Buenos Aires',
  'Catamarca',
  'Chaco',
  'Chubut',
  'Córdoba',
  'Corrientes',
  'Entre Ríos',
  'Formosa',
  'Jujuy',
  'La Pampa',
  'La Rioja',
  'Mendoza',
  'Misiones',
  'Neuquén',
  'Río Negro',
  'Salta',
  'San Juan',
  'San Luis',
  'Santa Cruz',
  'Santa Fe',
  'Santiago del Estero',
  'Tierra del Fuego',
  'Tucumán',
] as const;
// console.log(localStorage.getItem())
---
<form id="event-form" class="box">
  <label>Título<input name="title" required /></label>
  <label>Descripción<textarea name="description" rows="4"></textarea></label>
  <div class="row">
    <label class="grow">Inicio<input type="datetime-local" name="startDate" required /></label>
    <label class="grow">Fin<input type="datetime-local" name="endDate" /></label>
  </div>

  <div class="row">
    <label class="grow">Categoría
      <select name="category">
        {categoryOptions.map(({ value, label }) => (
          <option value={value}>{label}</option>
        ))}
      </select>
    </label>
    <label class="grow">Visibilidad
      <select name="visibility">
        {visibilityOptions.map(({ value, label }) => (
          <option value={value}>{label}</option>
        ))}
      </select>
    </label>
  </div>

  <div class="row">
    <label class="grow">HQ<input name="location" placeholder="Roque Sáenz Peña" /></label>
    <label class="grow">Provincia
      <select name="province">
        <option value="">Seleccioná una provincia</option>
        {provinceOptions.map((province) => (
          <option value={province}>{province}</option>
        ))}
      </select>
    </label>
  </div>

  <div id="institutional-event-fields" style="display:none;">
    <div class="row">
      <label class="grow">Institución asociada
        <select name="institutionId">
          <option value="">Seleccioná una institución</option>
        </select>
      </label>
      <label class="grow">Máx. asistentes<input type="number" name="maxAttendees" min="0" value="0" /></label>
    </div>

    <div class="row">
      <label class="grow">Etiquetas<input name="tags" placeholder="tech,networking" /></label>
      <label class="grow">¿Es gratis?<select name="isFree"><option value="true">Sí</option><option value="false">No</option></select></label>
    </div>

    <label id="price-field-wrapper" class="grow" style="display:none;">Precio<input type="number" name="price" min="0" step="0.01" placeholder="0.00" /></label>
    <label>Página web<input type="url" name="website" /></label>
    <label>URL de inscripción<input type="url" name="registrationUrl" /></label>
  </div>

  <label>Imagen del evento<input type="url" name="coverImage" placeholder="https://example.com/cover.jpg" /></label>

  <div class="ph" id="event-status" style="display:none"></div>
  <div class="row">
    <button class="btn" type="submit">Guardar evento</button>
    <a class="btn out" href={cancelHref}>Cancelar</a>
  </div>
</form>

<script>
  import { api, getAccessToken } from '@/lib/api';

  const form = document.getElementById('event-form') as HTMLFormElement | null;
  const statusBox = document.getElementById('event-status');
  const visibilityField = form?.querySelector('select[name="visibility"]') as HTMLSelectElement | null;

  const institutionalFields = document.getElementById('institutional-event-fields');
  const institutionSelect = form?.querySelector('select[name="institutionId"]') as HTMLSelectElement | null;
  const priceFieldWrapper = document.getElementById('price-field-wrapper');
  const isFreeField = form?.querySelector('select[name="isFree"]') as HTMLSelectElement | null;
  const startDateField = form?.querySelector('input[name="startDate"]') as HTMLInputElement | null;
  const endDateField = form?.querySelector('input[name="endDate"]') as HTMLInputElement | null;

  const loadInstitutions = async () => {
    if (!institutionSelect) return;

    try {
      const institutions = await api.getInstitutions();
      const previousValue = institutionSelect.value;
      institutionSelect.innerHTML = '<option value="">Seleccioná una institución</option>';

      if (Array.isArray(institutions) && institutions.length) {
        institutions.forEach((institution: Record<string, any>) => {
          const option = document.createElement('option');
          option.value = String(institution.id ?? '');
          option.textContent = institution.name ?? 'Institución';
          institutionSelect.appendChild(option);
        });
      } else {
        const option = document.createElement('option');
        option.value = '';
        option.textContent = 'No hay instituciones disponibles';
        institutionSelect.appendChild(option);
      }

      if (previousValue && Array.from(institutionSelect.options).some((option) => option.value === previousValue)) {
        institutionSelect.value = previousValue;
      }
    } catch (error) {
      institutionSelect.innerHTML = '<option value="">No se pudieron cargar las instituciones</option>';
    }
  };

  const minDateValue = new Date();
  minDateValue.setSeconds(0, 0);
  const minDateTime = minDateValue.toISOString().slice(0, 16);

  if (startDateField) (startDateField as HTMLInputElement).min = minDateTime;
  if (endDateField) (endDateField as HTMLInputElement).min = minDateTime;

  const updateInstitutionalVisibility = () => {
    const isInstitutional = String(visibilityField?.value ?? 'PUBLIC') === 'INSTITUTION';
    if (institutionalFields) {
      institutionalFields.style.display = isInstitutional ? 'block' : 'none';
    }
  };

  const updatePriceVisibility = () => {
    if (!priceFieldWrapper || !isFreeField) return;

    const isFree = String(isFreeField.value ?? 'true') === 'true';
    const priceInput = priceFieldWrapper.querySelector('input[name="price"]') as HTMLInputElement | null;

    priceFieldWrapper.style.display = isFree ? 'none' : 'block';

    if (priceInput) {
      priceInput.disabled = isFree;
      priceInput.required = !isFree;
    }
  };

  visibilityField?.addEventListener('change', updateInstitutionalVisibility);
  isFreeField?.addEventListener('change', updatePriceVisibility);
  void loadInstitutions();
  updateInstitutionalVisibility();
  updatePriceVisibility();

  const readImageFile = (file: Blob) => {
    if (!file) return Promise.resolve(undefined);
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result || ''));
      reader.onerror = () => reject(new Error('No se pudo leer la imagen seleccionada.'));
      reader.readAsDataURL(file);
    });
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const token = getAccessToken();
    if (!token) {
      if (statusBox) {
        statusBox.style.display = 'block';
        statusBox.textContent = 'Tu sesión expiró. Iniciá sesión nuevamente.';
      }
      window.location.href = '/login';
      return;
    }

    const formData = new FormData(form);
    const groupId = new URLSearchParams(window.location.search).get('groupId') || undefined;
    const visibility = groupId ? 'GROUP' : String(formData.get('visibility') ?? 'PUBLIC');
    const startDateRaw = formData.get('startDate');
    const endDateRaw = formData.get('endDate');
    const startDate = startDateRaw ? new Date(String(startDateRaw)) : null;
    const endDate = endDateRaw ? new Date(String(endDateRaw)) : startDate ? new Date(startDate.getTime()) : null;
    const isFree = String(formData.get('isFree') ?? 'true') === 'true';
    const location = String(formData.get('location') ?? '').trim();
    const city = String(formData.get('city') ?? '').trim();
    const province = String(formData.get('province') ?? '').trim();
    const institutionId = String(formData.get('institutionId') ?? '').trim();
    const provinceLabel = province === 'CABA' ? 'CABA' : province ? `Prov. ${province}` : '';
    const formattedLocation = [location, city, provinceLabel].filter(Boolean).join(' - ');
    const coverImage = String(formData.get('coverImage') ?? '').trim() || undefined;

    if (visibility === 'INSTITUTION' && !institutionId) {
      if (statusBox) {
        statusBox.style.display = 'block';
        statusBox.textContent = 'Seleccioná la institución a la que pertenece este evento institucional.';
      }
      return;
    }

    if (startDate && startDate < new Date()) {
      if (statusBox) {
        statusBox.style.display = 'block';
        statusBox.textContent = 'La fecha del evento no puede ser anterior a hoy.';
      }
      return;
    }

    if (endDate && startDate && endDate < startDate) {
      if (statusBox) {
        statusBox.style.display = 'block';
        statusBox.textContent = 'La fecha de fin debe ser igual o posterior a la de inicio.';
      }
      return;
    }

    const payload = {
      title: String(formData.get('title') ?? '').trim(),
      description: String(formData.get('description') ?? '').trim() || undefined,
      category: formData.get('category') || 'OTHER',
      visibility,
      groupId: groupId || undefined,
      institutionId: visibility === 'INSTITUTION' ? institutionId || undefined : undefined,
      startDate: startDate ? startDate.toISOString() : undefined,
      endDate: endDate ? endDate.toISOString() : undefined,
      location: formattedLocation || undefined,
      city: city || undefined,
      country: 'Argentina',
      tags: visibility === 'INSTITUTION'
        ? String(formData.get('tags') ?? '')
            .split(',')
            .map((tag) => tag.trim())
            .filter(Boolean)
        : [],
      maxAttendees: visibility === 'INSTITUTION' ? Number(formData.get('maxAttendees') ?? 0) : 0,
      isFree,
      price: isFree ? undefined : formData.get('price') ? Number(formData.get('price')) : undefined,
      website: String(formData.get('website') ?? '').trim() || undefined,
      registrationUrl: String(formData.get('registrationUrl') ?? '').trim() || undefined,
      coverImage,
      status: 'PUBLISHED',
    };

    if (!payload.title || !payload.startDate) {
      if (statusBox) {
        statusBox.style.display = 'block';
        statusBox.textContent = 'Completá título e inicio del evento.';
      }
      return;
    }

    if (statusBox) {
      statusBox.style.display = 'block';
      statusBox.textContent = 'Guardando evento...';
    }

    try {
      await api.createEvent(payload);
      window.location.href = '/dashboard';
    } catch (error) {
      if (statusBox) {
        statusBox.textContent = error instanceof Error ? error.message : 'No se pudo guardar el evento.';
      }
    }
  });
</script>
