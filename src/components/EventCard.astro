---
type EventCardProps = {
  event?: {
    id?: string;
    title?: string;
    category?: string;
    startDate?: string;
    start_date?: string;
    location?: string | null;
    city?: string | null;
    country?: string | null;
    address?: string | null;
    coverImage?: string | null;
    cover_image?: string | null;
    bannerImage?: string | null;
    banner_image?: string | null;
    [key: string]: unknown;
  };
  id?: string;
  title?: string;
  category?: string;
  startDate?: string;
  start_date?: string;
  location?: string | null;
  city?: string | null;
  country?: string | null;
  address?: string | null;
  coverImage?: string | null;
  cover_image?: string | null;
  bannerImage?: string | null;
  banner_image?: string | null;
};

const rawEvent = (Astro.props.event?.event ?? Astro.props.event ?? {}) as Record<string, any>;
const eventData = rawEvent as EventCardProps['event'];
const id = eventData?.id ?? Astro.props.id ?? '1';
const title = eventData?.title ?? Astro.props.title ?? 'Nombre del evento';
const category = eventData?.category ?? Astro.props.category ?? 'Evento';
const startDate = eventData?.startDate ?? eventData?.start_date ?? Astro.props.startDate ?? Astro.props.start_date;
const imageUrl = eventData?.coverImage ?? eventData?.cover_image ?? eventData?.bannerImage ?? eventData?.banner_image ?? Astro.props.coverImage ?? Astro.props.cover_image ?? Astro.props.bannerImage ?? Astro.props.banner_image ?? '';
const location = [
  eventData?.location ?? Astro.props.location,
  eventData?.city ?? Astro.props.city,
  eventData?.country ?? Astro.props.country,
  eventData?.address ?? Astro.props.address,
].filter(Boolean).join(' - ') || 'Sin ubicación';

const formatDate = (value?: string) => {
  if (!value) return 'Sin fecha';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return 'Sin fecha';
  return new Intl.DateTimeFormat('es-AR', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
  }).format(date);
};
---
<a href={`/events/${id}`} class="event-card">
  {imageUrl ? (
    <img src={imageUrl} alt={title} class="event-card__image" />
  ) : (
    <div class="event-card__image event-card__image--placeholder">Evento</div>
  )}

  <div class="event-card__content">
    <span class="event-card__tag">{category}</span>
    <h3>{title}</h3>
    <p class="event-card__date">{formatDate(startDate)}</p>
    <p class="event-card__location">{location}</p>
  </div>
</a>

<style>
  .event-card {
    display: block;
    width: 100%;
    background: #fff;
    border: 1px solid #e6e7ef;
    border-radius: 18px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 8px 20px rgba(17, 24, 39, 0.05);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .event-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(17, 24, 39, 0.08);
  }

  .event-card__image {
    display: block;
    width: 100%;
    height: 180px;
    object-fit: cover;
    background: #eef2ff;
  }

  .event-card__image--placeholder {
    display: grid;
    place-items: center;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #5b63b7;
    background: linear-gradient(135deg, #eef2ff 0%, #e0f2fe 100%);
  }

  .event-card__content {
    padding: 1rem;
  }

  .event-card__tag {
    display: inline-block;
    padding: 0.32rem 0.7rem;
    border-radius: 999px;
    background: #eef2ff;
    color: #3644c9;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .event-card h3 {
    margin: 0.8rem 0 0.5rem;
    font-size: 1.1rem;
    line-height: 1.35;
    color: #1f2937;
  }

  .event-card__date,
  .event-card__location {
    margin: 0.2rem 0;
    color: #4b5563;
    font-size: 0.92rem;
  }
</style>
